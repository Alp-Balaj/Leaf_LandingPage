---
import Layout from '../prototypes/quiet-stone/Layout.astro';
import Header from '../prototypes/quiet-stone/Header.astro';
import Hero from '../prototypes/quiet-stone/Hero.astro';
import Statement from '../prototypes/quiet-stone/Statement.astro';
import Borrowers from '../prototypes/quiet-stone/Borrowers.astro';
import Lifecycle from '../prototypes/quiet-stone/Lifecycle.astro';
import Pace from '../prototypes/quiet-stone/Pace.astro';
import Quote from '../prototypes/quiet-stone/Quote.astro';
import Controls from '../prototypes/quiet-stone/Controls.astro';
import Demo from '../prototypes/quiet-stone/Demo.astro';
import Footer from '../prototypes/quiet-stone/Footer.astro';
---

<Layout
  title="Leaf — loan management for banks"
  description="Leaf is the loan management system your credit, risk and compliance teams share, from the first application to the last repayment."
  theme="dark"
>
  <Header />
  <main>
    <Hero background="loop" />
    <Statement />
    <Lifecycle />
    <Pace />
    <Borrowers />
    <Quote />
    <Controls />
    <Demo />
  </main>
  <Footer />
</Layout>

<script>
  import '../prototypes/quiet-stone/motion.ts';
</script>
