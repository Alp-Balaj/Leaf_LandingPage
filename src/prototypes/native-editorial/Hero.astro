---
import RecordMock from './RecordMock.astro';

const headline = 'From application to collection, on one record.';
const words = headline.split(' ');
---

<header class="hero wrap">
  <h1 class="hero-h1" aria-label={headline}>
    {
      words.map((w, i) => (
        <span class="hero-w" aria-hidden="true" style={`--i:${i}`}>
          <span>{w}</span>
        </span>
      ))
    }
  </h1>

  <div class="hero-side">
    <p class="hero-lede">
      Leaf is the loan management system your credit, risk and compliance teams share, from the
      first application to the last repayment.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#demo">Book a 45-minute demo</a>
      <a class="link-quiet" href="#lifecycle">See how it works</a>
    </div>
  </div>

  <figure class="hero-record">
    <RecordMock />
    <figcaption class="hero-cap">
      The single loan record. Illustrative data; every stage, approval and change lives here.
    </figcaption>
  </figure>
</header>
