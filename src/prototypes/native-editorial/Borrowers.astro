---
const borrowers = [
  {
    title: 'Individuals',
    body: 'Income and expense analysis, co-borrowers and guarantors, payroll-linked loans created automatically.',
  },
  {
    title: 'Micro and SME',
    body: 'Balance sheet and P&L over three periods, declared against assumed figures, and credit limits that open new applications.',
  },
  {
    title: 'Corporate',
    body: 'Full financial-statement analysis, legal opinion, mortgages and movable collateral kept with their history.',
  },
];
---

<section id="borrowers" class="sec">
  <div class="wrap">
    <div class="runhead" data-reveal>
      <span>Every borrower</span>
      <a href="#demo">Book a 45-minute demo</a>
    </div>
    <div class="sec-head" data-reveal>
      <h2 class="sec-title">Individuals, micro, SME and corporate in one place.</h2>
      <p class="sec-intro">
        The analysis changes with the borrower. The record, the approvals and the audit trail do
        not.
      </p>
    </div>
    <div class="bor-grid">
      {
        borrowers.map((b) => (
          <div class="bor" data-reveal>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
