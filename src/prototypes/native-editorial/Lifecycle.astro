---
const stages = [
  {
    name: 'Apply',
    body: 'Individuals, micro, SME and corporate clients in one place. Client data, products, co-borrowers and guarantors are captured once and reused at every later step.',
    who: 'Branch officer',
    panel: [
      ['Client type', 'SME'],
      ['Co-borrower', 'Added, 1'],
      ['Guarantor', 'Added, 1'],
      ['Product', 'Working-capital loan'],
    ],
  },
  {
    name: 'Score',
    body: 'Financial statements, credit-registry exposure and your internal scorecard come together in the file, with knock-out and adjustment criteria applied automatically.',
    who: 'Credit analyst, risk',
    panel: [
      ['Statements', '3 periods, declared vs assumed'],
      ['Registry exposure', 'Imported 9 Sep'],
      ['Knock-out criteria', '0 triggered'],
      ['Adjustments', '2 applied'],
    ],
  },
  {
    name: 'Approve',
    body: 'The application routes from branch to risk to committee by the approval limits you set per branch and product.',
    who: 'Branch manager, risk, committee',
    panel: [
      ['Branch manager', 'Recommended, 12 Sep'],
      ['Risk department', 'Approved, 13 Sep'],
      ['Credit committee', 'Not required'],
      ['Limit applied', 'Risk, to EUR 150,000'],
    ],
  },
  {
    name: 'Disburse',
    body: 'Contracts are generated from your own templates. Collateral and mortgages sit on the same record, and disbursement is controlled product by product.',
    who: 'Credit administration',
    panel: [
      ['Contract', 'Template SME-WC v3'],
      ['Mortgage', 'Registered'],
      ['Movable pledge', 'Registered'],
      ['Disbursement', 'Tranche 1 of 1, 22 Sep'],
    ],
  },
  {
    name: 'Monitor',
    body: 'Reviews and early warnings are raised automatically for collateral revaluation, product expiry and special conditions.',
    who: 'Monitoring team',
    panel: [
      ['Collateral revaluation', 'Due 2 Sep 2027'],
      ['Special condition', 'Review in 30 days'],
      ['Product expiry', 'Sep 2029'],
      ['Early warnings', 'None open'],
    ],
  },
  {
    name: 'Collect',
    body: 'Arrears are sorted by days of delay and handed to collectors or executors. Restructure terms without opening a new file.',
    who: 'Collections',
    panel: [
      ['Days of delay', '0'],
      ['Bucket', 'Current'],
      ['Assigned to', 'Not assigned'],
      ['Restructure', 'Available on this file'],
    ],
  },
];
---

<section id="lifecycle" class="sec">
  <div class="wrap">
    <div class="runhead" data-reveal>
      <span>How Leaf works</span>
      <a href="#demo">Book a 45-minute demo</a>
    </div>

    <div class="sec-head" data-reveal>
      <h2 class="sec-title">Six stages, one record, every hand-off tracked.</h2>
      <p class="sec-intro">
        Open a stage to see who works it and what the record holds at that point. Nothing waits in
        someone's inbox.
      </p>
    </div>

    <div class="lc">
      <ol class="lc-list" data-reveal>
        {
          stages.map((s, i) => {
            const open = i === 0;
            return (
              <li class="lc-item">
                <button
                  type="button"
                  class="lc-btn"
                  id={`lc-btn-${i}`}
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={`lc-panel-${i}`}
                  data-stage={i}
                >
                  <span class="lc-n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="lc-name">{s.name}</span>
                  <span class="lc-who">{s.who}</span>
                  <span class="lc-sign" aria-hidden="true" />
                </button>
                <div
                  class="lc-panel"
                  id={`lc-panel-${i}`}
                  role="region"
                  aria-labelledby={`lc-btn-${i}`}
                  data-open={open ? 'true' : 'false'}
                >
                  <div class="lc-panel-in">
                    <p>{s.body}</p>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>

      <div class="lc-mock" data-reveal>
        <div
          class="rec rec-sm"
          data-stage="0"
          role="img"
          aria-label="Illustrative Leaf record showing the selected stage on the timeline and the fields that stage adds."
        >
          <div class="rec-bar">
            <span class="rec-logo"><img src="/leaf.svg" alt="" width="14" height="13" /> Leaf</span>
            <span class="rec-crumb">Loans / LF-2026-0418</span>
          </div>
          <ol class="rec-tl rec-tl-sm">
            {
              stages.map((s, i) => (
                <li data-i={i}>
                  <span class="rec-tl-dot" />
                  <span class="rec-tl-name">{s.name}</span>
                </li>
              ))
            }
          </ol>
          <div class="rec-stage">
            {
              stages.map((s, i) => (
                <div class="rec-stage-panel" data-i={i}>
                  <p class="rec-h">{s.name}</p>
                  <dl class="rec-kv">
                    {s.panel.map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="rec-foot">Worked by: {s.who}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('lifecycle')!;
  const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.lc-btn'));
  const mock = root.querySelector<HTMLElement>('.rec-sm')!;

  function setStage(i: number) {
    mock.dataset.stage = String(i);
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const wasOpen = button.getAttribute('aria-expanded') === 'true';
      buttons.forEach((b) => {
        const open = b === button && !wasOpen;
        b.setAttribute('aria-expanded', String(open));
        const panel = document.getElementById(b.getAttribute('aria-controls')!)!;
        panel.dataset.open = String(open);
      });
      if (!wasOpen) setStage(Number(button.dataset.stage));
    });
  });

  setStage(0);
</script>
