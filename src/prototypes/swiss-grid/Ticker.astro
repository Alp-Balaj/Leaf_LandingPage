---
const stages = ['Apply', 'Score', 'Approve', 'Disburse', 'Monitor', 'Collect'];
---

<div class="ticker" aria-label="The six stages of a loan in Leaf">
  <div class="track">
    <ol class="run display">
      {stages.map((s, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
    </ol>
    <ol class="run display" aria-hidden="true">
      {stages.map((s, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
    </ol>
  </div>
</div>

<style>
  .ticker {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    overflow: hidden;
    background: var(--paper);
  }

  .track {
    display: flex;
    width: max-content;
    animation: ticker 36s linear infinite;
  }

  .ticker:hover .track,
  .ticker:focus-within .track {
    animation-play-state: paused;
  }

  .run {
    display: flex;
    flex-shrink: 0;
  }

  .run li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 40px 18px 0;
    margin-right: 40px;
    border-right: 1px solid var(--ink);
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1;
    white-space: nowrap;
  }

  .run li:first-child {
    padding-left: 24px;
  }

  .run li span {
    font-size: 0.5em;
    color: var(--ink-muted);
  }

  @keyframes ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      width: 100%;
      overflow-x: auto;
    }

    .run[aria-hidden='true'] {
      display: none;
    }
  }
</style>
