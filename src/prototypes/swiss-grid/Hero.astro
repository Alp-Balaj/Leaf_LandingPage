---
import RecordMock from './RecordMock.astro';
---

<section class="hero">
  <div class="wrap">
    <h1 class="display" data-split>From application to collection, on one record.</h1>

    <div class="cols hero-row">
      <div class="hero-text">
        <p class="lede" data-reveal>
          Leaf is the loan management system your credit, risk and compliance teams share, from
          the first application to the last repayment.
        </p>
        <div class="actions" data-reveal>
          <a class="btn" href="#demo">Book a 45-minute demo</a>
          <a class="btn-ghost" href="#lifecycle">See the six stages</a>
        </div>
        <p class="note muted" data-reveal>
          One record per loan. Every approval stored with approver, limit and timestamp.
        </p>
      </div>
      <div class="hero-mock" data-reveal>
        <RecordMock />
      </div>
    </div>
  </div>
</section>

<style>
  .hero > .wrap {
    padding-top: clamp(40px, 6vw, 88px);
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(40px, 7.4vw, 108px);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }

  .hero-row {
    margin-top: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .hero-text {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-right: 8px;
  }

  .hero-mock {
    grid-column: 5 / span 8;
  }

  .lede {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.45;
    max-width: 36ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .note {
    font-size: 14px;
    max-width: 30ch;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
  }

  @media (max-width: 900px) {
    .hero-text {
      grid-column: 1 / span 6;
      margin-bottom: 40px;
    }

    .hero-mock {
      grid-column: 1 / span 6;
    }
  }

  @media (max-width: 600px) {
    .hero-text,
    .hero-mock {
      grid-column: 1 / span 4;
    }
  }
</style>
