---
const roles = [
  'Retail or SME lending',
  'Credit risk',
  'Operations',
  'IT',
  'Compliance',
  'Management board',
];
---

<section id="demo" class="section demo">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="section-num">05</p>
      <p class="section-label">Demo. See your own loan process in Leaf.</p>
    </div>

    <div class="cols demo-grid">
      <div class="pitch" data-reveal>
        <p class="big display">45 minutes on a live Leaf instance, with the team that builds it.</p>
        <p>Bring your credit and risk leads. We reply within one working day to set a time. No marketing emails.</p>
        <p class="contact">
          Or call <a href="tel:+38338229170">+383 38 229 170</a><br />
          <a href="https://interadria-ks.com">interadria-ks.com</a>
        </p>
      </div>

      <div class="form-col" data-reveal>
        <div class="thanks" hidden>
          <p class="thanks-title display" tabindex="-1">Thank you.</p>
          <p>We will contact you within one working day to set a time.</p>
        </div>

        <!-- TODO: point action at the real endpoint that receives demo requests. -->
        <form class="demo-form" method="post" action="#">
          <div class="field">
            <label class="label" for="sg-name">Full name</label>
            <input id="sg-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label class="label" for="sg-bank">Bank</label>
            <input id="sg-bank" name="bank" type="text" autocomplete="organization" required />
          </div>
          <div class="field">
            <label class="label" for="sg-role">Your role</label>
            <select id="sg-role" name="role">
              {roles.map((r) => <option>{r}</option>)}
            </select>
          </div>
          <div class="field">
            <label class="label" for="sg-email">Work email</label>
            <input id="sg-email" name="email" type="email" autocomplete="email" required />
          </div>
          <button type="submit" class="btn submit">Book a 45-minute demo</button>
          <p class="privacy muted">We use these details only to arrange the demo. [Link to privacy notice]</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#demo .demo-form');
  const thanks = document.querySelector<HTMLElement>('#demo .thanks');

  if (form && thanks) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.hidden = true;
      thanks.hidden = false;
      thanks.querySelector<HTMLElement>('.thanks-title')?.focus();
    });
  }
</script>

<style>
  /* The one red rule on the page: above the ask. */
  .demo {
    border-top: 2px solid var(--red);
  }

  .demo-grid {
    align-items: start;
  }

  .pitch {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 16px;
    line-height: 1.5;
  }

  .big {
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.15;
    max-width: 20ch;
  }

  .pitch p:not(.big) {
    max-width: 38ch;
  }

  .contact {
    line-height: 1.7;
  }

  .form-col {
    grid-column: 7 / span 6;
  }

  .thanks {
    padding-top: 6px;
  }

  .thanks-title {
    font-size: 32px;
    outline: none;
    margin-bottom: 12px;
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .demo-form[hidden] {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  label {
    color: var(--ink-muted);
  }

  input,
  select {
    min-height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    color: var(--ink);
    font-family: var(--body);
    font-weight: 400;
    font-size: 18px;
  }

  input:focus-visible,
  select:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--ink);
  }

  .submit {
    align-self: flex-start;
    margin-top: 6px;
  }

  .privacy {
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .pitch {
      grid-column: 1 / span 6;
      margin-bottom: 40px;
    }

    .form-col {
      grid-column: 1 / span 6;
    }
  }

  @media (max-width: 600px) {
    .pitch,
    .form-col {
      grid-column: 1 / span 4;
    }

    .submit {
      align-self: stretch;
    }
  }
</style>
