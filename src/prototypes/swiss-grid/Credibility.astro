---
const facts = [
  {
    k: 'Built by',
    v: 'iA (Inter Adria), Prishtina, since [year].',
    link: { href: 'https://interadria-ks.com', text: 'interadria-ks.com' },
  },
  { k: 'Running at', v: '[Pilot or launch bank, named only with permission.]' },
  { k: 'Hosting', v: '[On-premise in your data centre or hosted; data residency statement.]' },
  { k: 'Reporting', v: '[Regulator reporting formats and standards iA can truthfully claim.]' },
];
---

<section id="builder" class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="section-num">01</p>
      <p class="section-label">Who builds it</p>
    </div>
    <dl class="cols facts" data-reveal>
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="label muted">{f.k}</dt>
            <dd>
              {f.v}
              {f.link && (
                <>
                  {' '}
                  <a href={f.link.href}>{f.link.text}</a>
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts {
    margin: 0;
    row-gap: 28px;
  }

  .fact {
    grid-column: span 3;
    padding-top: 12px;
    border-top: 1px solid var(--ink);
  }

  dd {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.45;
    max-width: 28ch;
  }

  @media (max-width: 900px) {
    .fact {
      grid-column: span 3;
    }
  }

  @media (max-width: 600px) {
    .fact {
      grid-column: span 4;
    }
  }
</style>
