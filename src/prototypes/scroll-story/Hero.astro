---
import RecordMock from './RecordMock.astro';
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>From application to collection, on one record.</h1>
      <p class="lede" data-rise>
        Leaf is the loan management system your credit, risk and compliance teams share, from the
        first application to the last repayment.
      </p>
      <div class="actions" data-rise>
        <a class="btn" href="#demo">Book a 45-minute demo</a>
        <a class="link" href="#lifecycle">See how it works</a>
      </div>
      <p class="byline" data-rise>
        <img src="/ia.svg" alt="" width="14" height="16" />
        Built and supported by iA, Prishtina
      </p>
    </div>
    <div class="hero-mock">
      <RecordMock variant="hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
      radial-gradient(900px 600px at 85% 20%, #14241a 0%, transparent 60%),
      var(--ground);
  }

  .hero-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 48px 64px;
    align-items: center;
    padding-top: clamp(32px, 4vw, 48px);
    padding-bottom: clamp(32px, 4vw, 48px);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 5.4vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.005em;
    text-wrap: balance;
    max-width: 12ch;
  }

  .lede {
    margin-top: 28px;
    max-width: 50ch;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
  }

  .link {
    color: var(--ink);
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--line-strong);
    padding: 10px 0;
  }

  .link:hover {
    text-decoration-color: var(--red);
  }

  .byline {
    margin-top: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .hero-mock {
    justify-self: end;
    width: 100%;
    max-width: 560px;
  }

  @media (max-width: 899px) {
    .hero {
      min-height: 0;
      align-items: start;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 56px;
    }

    .byline {
      margin-top: 36px;
    }

    .hero-mock {
      justify-self: stretch;
      max-width: none;
    }
  }
</style>
