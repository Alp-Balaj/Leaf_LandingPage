---
const controls = [
  {
    title: 'Permissions by role and module',
    body: 'Each user sees and does only what their role allows.',
  },
  {
    title: 'Approval limits per branch and product',
    body: 'Applications route to the right authority by your rules.',
  },
  {
    title: 'Full audit trail',
    body: 'Who changed what, and when, on every application.',
  },
  {
    title: 'Credit registry and core banking',
    body: 'Exposure imported from the registry; accounts and payments read from your core system.',
  },
  {
    title: 'Your own scorecards',
    body: 'Internal rating models with knock-out and adjustment criteria.',
  },
  {
    title: '[Deployment and certification]',
    body: '[On-premise in your data centre? ISO 27001? Confirm before publishing.]',
  },
];
---

<section class="sec controls">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2>Built to pass your risk and compliance review.</h2>
      <p>The controls a bank asks about first, already in the product.</p>
    </div>
    <ul class="check-list">
      {
        controls.map((c) => (
          <li data-reveal>
            <span class="check" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="16" height="16"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <div>
              <p class="check-title">{c.title}</p>
              <p class="check-body">{c.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .controls {
    border-top: 1px solid var(--line);
  }

  .check-list {
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 64px;
  }

  li {
    display: flex;
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .check {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    margin-top: 1px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--ink);
  }

  .check-title {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }

  .check-body {
    margin-top: 6px;
    max-width: 44ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  @media (max-width: 799px) {
    .check-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
