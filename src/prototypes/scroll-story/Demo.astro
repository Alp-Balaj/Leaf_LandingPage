---
const roles = [
  'Retail or SME lending',
  'Credit risk',
  'Operations',
  'IT',
  'Compliance',
  'Management board',
];
---

<section id="demo" class="sec paper">
  <div class="wrap demo-grid">
    <div class="demo-copy" data-reveal>
      <h2>See your own loan process in Leaf.</h2>
      <p class="pitch">45 minutes with the team that builds it. Bring your credit and risk leads.</p>
      <ul class="demo-what">
        <li>A live Leaf instance, not slides.</li>
        <li>Your products, your approval limits, your scorecard.</li>
        <li>We reply within one working day to set a time.</li>
      </ul>
      <p class="contact">
        Or call <a href="tel:+38338229170">+383 38 229 170</a><br />
        <a href="https://interadria-ks.com">interadria-ks.com</a>
      </p>
    </div>

    <div class="form-col" data-reveal>
      <div class="thanks" hidden>
        <p class="thanks-title" tabindex="-1">Thank you.</p>
        <p class="thanks-body">We will contact you within one working day to set a time.</p>
      </div>

      <!-- TODO: point action at the real endpoint that receives demo requests. -->
      <form class="demo-form" method="post" action="#">
        <div class="field">
          <label for="ss-name">Full name</label>
          <input id="ss-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="ss-bank">Bank</label>
          <input id="ss-bank" name="bank" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="ss-role">Your role</label>
          <select id="ss-role" name="role">
            {roles.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="ss-email">Work email</label>
          <input id="ss-email" name="email" type="email" autocomplete="email" required />
        </div>
        <button type="submit" class="btn submit">Request a demo</button>
        <p class="privacy">We use these details only to arrange the demo. [Link to privacy notice]</p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#demo .demo-form')!;
  const thanks = document.querySelector<HTMLElement>('#demo .thanks')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    thanks.hidden = false;
    thanks.querySelector<HTMLElement>('.thanks-title')!.focus();
  });
</script>

<style>
  .paper {
    background: var(--paper);
    color: var(--paper-ink);
  }

  .demo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 420px);
    gap: 48px clamp(48px, 8vw, 120px);
    align-items: start;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.005em;
    text-wrap: balance;
    max-width: 14ch;
  }

  .pitch {
    margin-top: 22px;
    max-width: 40ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--paper-ink);
  }

  .demo-what {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--paper-ink-2);
  }

  .demo-what li {
    padding-left: 18px;
    position: relative;
  }

  .demo-what li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 2px;
    background: var(--red);
  }

  .contact {
    margin-top: 36px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--paper-ink-2);
  }

  .contact a {
    color: var(--paper-ink);
  }

  .thanks-title {
    font-family: var(--font-display);
    font-size: 36px;
    outline: none;
  }

  .thanks-body {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--paper-ink-2);
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .demo-form[hidden] {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  label {
    font-size: 14px;
    font-weight: 500;
    color: var(--paper-ink);
  }

  input,
  select {
    min-height: 50px;
    padding: 0 14px;
    background: #ffffff;
    border: 1px solid var(--paper-line);
    border-radius: 4px;
    color: var(--paper-ink);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
  }

  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 1px;
    border-color: var(--red);
  }

  .submit {
    align-self: flex-start;
    margin-top: 8px;
  }

  .privacy {
    font-size: 13px;
    line-height: 1.5;
    color: var(--paper-ink-2);
  }

  @media (max-width: 799px) {
    .demo-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
