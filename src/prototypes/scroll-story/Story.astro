---
import RecordMock from './RecordMock.astro';

const stages = [
  {
    name: 'Apply',
    body: 'Individuals, micro, SME and corporate clients in one place. Client data, products, co-borrowers and guarantors are captured once and reused at every later step.',
    who: 'Branch officer',
    change: 'The record opens with the client, the product and the guarantor.',
  },
  {
    name: 'Score',
    body: 'Financial statements, credit-registry exposure and your internal scorecard come together in the file, with knock-out and adjustment criteria applied automatically.',
    who: 'Credit analyst and risk',
    change: 'The score, registry exposure and knock-out result land on the same file.',
  },
  {
    name: 'Approve',
    body: 'The application routes from branch to risk to committee by the approval limits you set per branch and product.',
    who: 'Branch manager, risk, committee',
    change: 'Each approval is stamped with approver, limit and time.',
  },
  {
    name: 'Disburse',
    body: 'Contracts are generated from your own templates. Collateral and mortgages sit on the same record, and disbursement is controlled product by product.',
    who: 'Credit administration',
    change: 'Contract, mortgage and the disbursed amount attach to the record.',
  },
  {
    name: 'Monitor',
    body: 'Reviews and early warnings are raised automatically for collateral revaluation, product expiry and special conditions.',
    who: 'Monitoring team',
    change: 'An early-warning flag appears before the revaluation is overdue.',
  },
  {
    name: 'Collect',
    body: 'Arrears are sorted by days of delay and handed to collectors or executors. Restructure terms without opening a new file.',
    who: 'Collections',
    change: 'The arrears bucket shows on the same file, with the collector named.',
  },
];
---

<section id="lifecycle" class="story">
  <div class="wrap story-head">
    <h2>How Leaf works, step by step.</h2>
    <p>
      One record carries the loan through six hand-offs. Scroll, and watch the file fill in as
      each team does its part.
    </p>
  </div>

  <div class="wrap story-grid">
    <div class="story-pin">
      <RecordMock variant="story" />
    </div>

    <div class="story-stages">
      <div class="rail" aria-hidden="true"><div class="rail-fill"></div></div>
      <ol class="stage-list">
        {
          stages.map((s, i) => (
            <li class="stage-block">
              <p class="stage-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3>
                <span class="sr-only">Step {i + 1}: </span>
                {s.name}
              </h3>
              <p class="stage-body">{s.body}</p>
              <p class="stage-change">{s.change}</p>
              <p class="stage-who">{s.who}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="wrap story-cta">
    <p>See this on your own loan process, with your products and your approval limits.</p>
    <a class="btn" href="#demo">Book a 45-minute demo</a>
  </div>
</section>

<style>
  .story {
    padding-top: clamp(72px, 10vw, 128px);
    border-top: 1px solid var(--line);
  }

  .story-head {
    max-width: 760px;
  }

  .story-head p {
    margin-top: 20px;
    max-width: 52ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .story-grid {
    margin-top: clamp(48px, 6vw, 80px);
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
    gap: 0 clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .story-pin {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: flex-start;
    padding: 20px 0 24px;
  }

  .story-stages {
    position: relative;
    padding-left: 40px;
  }

  .rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--line);
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--red);
    transform-origin: top;
    transform: scaleY(1);
  }

  .stage-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage-block {
    min-height: 74vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 0;
    color: var(--ink-3);
    transition: color 400ms ease;
  }

  .stage-block.is-active,
  .stage-block:not(.is-active):only-child {
    color: var(--ink);
  }

  .stage-num {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.08em;
    color: var(--red-text);
  }

  h3 {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1;
    color: inherit;
  }

  .stage-body {
    margin-top: 22px;
    max-width: 46ch;
    font-size: 18px;
    line-height: 1.55;
    color: inherit;
  }

  .stage-change {
    margin-top: 18px;
    max-width: 40ch;
    padding-left: 14px;
    border-left: 2px solid var(--red);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .stage-who {
    margin-top: 22px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .story-cta {
    margin-top: clamp(48px, 6vw, 96px);
    padding-top: 40px;
    padding-bottom: clamp(72px, 10vw, 128px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }

  .story-cta p {
    max-width: 44ch;
    font-size: 20px;
    line-height: 1.4;
  }

  /* Narrow screens: no pinned record, one stacked column. The hero already showed the full record. */
  @media (max-width: 899px) {
    .story-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .story-pin {
      display: none;
    }

    .story-stages {
      padding-left: 26px;
    }

    .stage-block {
      min-height: 0;
      padding: 28px 0;
      color: var(--ink);
    }

    .stage-block + .stage-block {
      border-top: 1px solid var(--line);
    }

    .stage-body {
      font-size: 17px;
    }
  }

  /* Reduced motion: readable static layout, nothing pinned, every stage in full ink. */
  @media (prefers-reduced-motion: reduce) {
    .story-pin {
      min-height: 0;
    }

    .stage-block {
      min-height: 0;
      color: var(--ink);
    }
  }
</style>
