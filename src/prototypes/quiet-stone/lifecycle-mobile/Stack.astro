---
/* Mobile variant A, "File stack": each stage is a sheet of the same loan file. Sheets stick
   one tab lower than the last, so scrolling piles them into a file whose tabs read as the
   chain of teams. Sample data only. */
import { stages, roman } from '../lifecycle-stages';
---

<div class="stack-wrap" data-stack>
  <p class="stack-file">
    <span class="label">Loan file</span>
    <span>LF-2026-0418, Example Trading Sh.p.k.</span>
  </p>

  <ol class="stack">
    {
      stages.map((s, i) => (
        <li class="sheet" style={`--i:${i}`} data-sheet>
          <div class="sheet-tab">
            <span class="sheet-n">{roman[i]}</span>
            <h3 class="sheet-name">{s.name}</h3>
            <span class="sheet-who">{s.who}</span>
          </div>
          <div class="sheet-body">
            <p class="sheet-copy">{s.body}</p>
            <dl class="rec-kv">
              {s.panel.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="stack-end">The same file, from the first application to the last repayment.</p>
</div>

<style>
  .stack-wrap {
    --tab: 46px;
    --pin: calc(var(--header-h) + 8px);
  }

  /* Short phones: tighter tabs so six tabs and one open sheet still fit. */
  @media (height <= 720px) {
    .stack-wrap {
      --tab: 38px;
    }
  }

  .stack-file {
    display: grid;
    gap: 6px;
    margin-bottom: 28px;
    font-size: var(--t-sm);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sheet {
    position: sticky;
    top: calc(var(--pin) + var(--i) * var(--tab));
    background: var(--paper);
    color: var(--ink);
    --ink-soft: color-mix(in srgb, var(--ink) 62%, var(--paper));
    --rule: color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 3px;
    box-shadow: 0 -6px 18px #00000038;
    font-variant-numeric: tabular-nums;
  }

  /* Spacing goes above each sheet: a bottom margin would count against the sticky limit
     and push the lower sheets up over the tabs. Sheet heights differ by less than a tab,
     so a covered sheet never shows below the one on top. */
  .sheet + .sheet {
    margin-top: 18vh;
  }

  .sheet-tab {
    height: var(--tab);
    display: flex;
    align-items: center;
    gap: 14px;
    padding-inline: 18px;
    border-bottom: 1px solid var(--rule);
  }

  .sheet-n {
    width: 1.75rem;
    flex: none;
    font: 400 var(--t-sm) / 1 var(--font-display);
    color: var(--ink-soft);
    transition: color 0.5s var(--ease);
  }

  .sheet-name {
    font: 400 1.25rem / 1 var(--font-display);
  }

  .sheet-who {
    margin-left: auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }

  .sheet-body {
    padding: 18px 18px 20px;
  }

  .sheet-copy {
    font-size: var(--t-sm);
    line-height: 1.55;
    margin-bottom: 14px;
  }

  .sheet .rec-kv {
    font-size: var(--t-sm);
  }

  .sheet .rec-kv > div {
    padding: 8px 0;
  }

  .sheet .rec-kv > div:last-child {
    border-bottom: 0;
  }

  /* The sheet on top of the pile carries the red numeral; the ones beneath fade back. */
  .sheet.is-top .sheet-n {
    color: var(--accent);
  }

  .sheet.is-under {
    background: color-mix(in srgb, var(--paper) 90%, var(--ink));
  }

  .stack-end {
    margin-top: 40px;
    max-width: 28ch;
    font: 400 var(--t-lg) / 1.3 var(--font-display);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet {
      transition: background-color 0.6s var(--ease);
    }
  }
</style>

<script>
  // Mark the sheet on top of the pile (the last one pinned) and the ones it covers.
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach((wrap) => {
    const sheets = [...wrap.querySelectorAll<HTMLElement>('[data-sheet]')];
    let queued = false;

    const update = () => {
      queued = false;
      let top = 0;
      sheets.forEach((s, i) => {
        const pinAt = parseFloat(getComputedStyle(s).top);
        if (s.getBoundingClientRect().top <= pinAt + 1) top = i;
      });
      sheets.forEach((s, i) => {
        s.classList.toggle('is-top', i === top);
        s.classList.toggle('is-under', i < top);
      });
    };

    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
    addEventListener('resize', update);
    update();
  });
</script>
