---
/* Mobile variant C, "Hand-off rail": a vertical rail of six nodes, one open at a time
   (native exclusive <details>). Closed, the rows read as the chain of teams; open, a stage
   shows its page of the record and a button that hands it to the next team. The rail fills
   up to the open stage with CSS :has(). Sample data only. */
import { stages, roman } from '../lifecycle-stages';
---

<ol class="relay" data-relay>
  {
    stages.map((s, i) => (
      <li class="relay-item">
        <details name="qs-relay" open={i === 0} data-relay-item>
          <summary class="relay-sum">
            <span class="relay-node" aria-hidden="true">{roman[i]}</span>
            <span class="relay-head">
              <span class="relay-name">{s.name}</span>
              <span class="relay-who">{s.who}</span>
            </span>
            <span class="relay-icon" aria-hidden="true" />
          </summary>
          <div class="relay-body">
            <p class="relay-copy">{s.body}</p>
            <div class="relay-sheet">
              <dl class="rec-kv">
                {s.panel.map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            {i < stages.length - 1 && (
              <button type="button" class="relay-next" data-relay-next>
                <span class="relay-next-k">Hand to {stages[i + 1].name}</span>
                <span class="relay-next-who">{stages[i + 1].who}</span>
              </button>
            )}
          </div>
        </details>
      </li>
    ))
  }
</ol>

<style>
  .relay {
    --node: 40px;
    list-style: none;
    margin: 0;
    padding: 0;
    interpolate-size: allow-keywords;
  }

  .relay-item {
    position: relative;
  }

  /* The rail: a segment from each node down to the next. */
  .relay-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--node) / 2);
    top: calc(14px + var(--node));
    bottom: -14px;
    width: 1px;
    background: var(--rule);
    transition: background-color 0.6s var(--ease);
  }

  /* Every stage before the open one is done: its node fills and its segment turns solid. */
  .relay-item:has(~ .relay-item > details[open])::before {
    background: var(--stone);
  }

  .relay-sum {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    list-style: none;
    cursor: pointer;
    scroll-margin-top: calc(var(--header-h) + 12px);
  }

  .relay-sum::-webkit-details-marker {
    display: none;
  }

  .relay-sum:focus-visible {
    outline-offset: 2px;
  }

  .relay-node {
    flex: none;
    width: var(--node);
    height: var(--node);
    display: grid;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--ink);
    font: 400 var(--t-xs) / 1 var(--font-display);
    color: var(--ink-soft);
    transition:
      background-color 0.6s var(--ease),
      border-color 0.6s var(--ease),
      color 0.6s var(--ease);
  }

  .relay-item:has(~ .relay-item > details[open]) .relay-node {
    background: var(--stone);
    border-color: var(--stone);
    color: var(--ink);
  }

  details[open] .relay-node {
    border-color: var(--accent);
    color: var(--accent);
  }

  .relay-head {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .relay-name {
    font: 400 var(--t-xl) / 1.1 var(--font-display);
    transition: color 0.5s var(--ease);
  }

  details[open] .relay-name {
    color: color-mix(in srgb, var(--accent) 45%, var(--stone));
  }

  .relay-who {
    font-size: var(--t-xs);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  /* Plus that turns into a minus. */
  .relay-icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .relay-icon::before,
  .relay-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }

  .relay-icon::after {
    transform: rotate(90deg);
  }

  details[open] .relay-icon::after {
    transform: rotate(0deg);
  }

  .relay-body {
    padding: 4px 0 24px calc(var(--node) + 16px);
  }

  .relay-copy {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    margin-bottom: 16px;
  }

  .relay-sheet {
    padding: 4px 16px;
    background: var(--paper);
    color: var(--ink);
    --ink-soft: color-mix(in srgb, var(--ink) 62%, var(--paper));
    --rule: color-mix(in srgb, var(--ink) 14%, transparent);
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
    border-radius: 3px;
  }

  .relay-sheet .rec-kv > div {
    padding: 9px 0;
  }

  .relay-sheet .rec-kv > div:last-child {
    border-bottom: 0;
  }

  .relay-next {
    width: 100%;
    margin-top: 16px;
    display: grid;
    gap: 2px;
    padding: 12px 52px 12px 0;
    position: relative;
    background: none;
    border: 0;
    border-top: 1px solid var(--rule);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .relay-next-k {
    font-size: var(--t-sm);
    letter-spacing: 0.04em;
  }

  .relay-next-who {
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }

  /* The page's hairline arrow, pointing down the rail. */
  .relay-next::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 28px;
    height: 1px;
    background: currentColor;
    transition: width 0.6s var(--ease);
  }

  .relay-next:active::after {
    width: 44px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .relay details::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 0.6s var(--ease),
        content-visibility 0.6s allow-discrete;
    }

    .relay details[open]::details-content {
      block-size: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-relay]').forEach((relay) => {
    const items = [...relay.querySelectorAll<HTMLDetailsElement>('[data-relay-item]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let last = items.findIndex((d) => d.open);

    // Keep the opened row's heading on screen while the row above it collapses. The row
    // that just closed may still be animating, so subtract what it has left to shrink.
    const keepInView = (i: number) => {
      const sum = items[i].querySelector('summary')!;
      const prev = last >= 0 && last < i ? items[last] : null;
      const shrink = prev ? prev.offsetHeight - prev.querySelector('summary')!.offsetHeight : 0;
      const top = sum.getBoundingClientRect().top - shrink;
      const min = parseFloat(getComputedStyle(sum).scrollMarginTop) || 0;
      if (top < min || top > innerHeight * 0.6) {
        scrollTo({ top: scrollY + top - min, behavior: reduce ? 'auto' : 'smooth' });
      }
    };

    items.forEach((d, i) => {
      d.addEventListener('toggle', () => {
        if (!d.open) return;
        // Exclusive accordion for browsers without <details name>.
        items.forEach((o) => o !== d && (o.open = false));
        keepInView(i);
        last = i;
      });

      d.querySelector('[data-relay-next]')?.addEventListener('click', () => {
        items[i + 1].open = true;
        items[i + 1].querySelector('summary')!.focus({ preventScroll: true });
      });
    });
  });
</script>
