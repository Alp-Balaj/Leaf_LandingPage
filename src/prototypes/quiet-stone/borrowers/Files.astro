---
// "Case files": one file per borrower, its documents stacked behind it as index cards.
// The stacks sit on a common baseline, so they read as a staircase: more borrower, more paper.
import { borrowers, shared } from './data';
---

<section id="borrowers" class="sec bf">
  <div class="wrap">
    <div class="runhead" data-reveal>
      <h2 class="label">Every borrower</h2>
      <a class="link link-arrow" href="#demo">Book a demo</a>
    </div>
    <div class="bf-intro">
      <p class="sec-title" data-reveal style="--d:.1s">Individuals, micro, SME and corporate in one place.</p>
      <p class="bf-lede" data-reveal style="--d:.2s">
        A nurse renovating a kitchen and a freight company buying a fleet are filed the same way. Leaf
        asks each for what it needs, and keeps every document on the one record.
      </p>
    </div>

    <ol class="bf-files">
      {
        borrowers.map((b, i) => (
          <li class="bf-file" data-reveal style={`--d:${(i * 0.12).toFixed(2)}s`}>
            <div class="bf-stack" aria-label={`Documents on file: ${b.docs.join(', ')}`} role="img">
              {[...b.docs].reverse().map((d, j) => (
                <div class="bf-sheet" style={`--j:${b.docs.length - j}`}>
                  <span>{d}</span>
                  <span class="bf-sheet-n">{String(b.docs.length - j).padStart(2, '0')}</span>
                </div>
              ))}
            </div>

            <article class="bf-card">
              <header class="bf-card-head">
                <span class="bf-mono" aria-hidden="true">{b.monogram}</span>
                <span class="bf-meta">
                  <span class="bf-seg">{b.n} · {b.segment}</span>
                  <span class="bf-fileno">{b.file}</span>
                </span>
              </header>
              <h3 class="bf-name">{b.name}</h3>
              <p class="bf-about">{b.about}</p>
              <p class="bf-purpose">“{b.purpose}”</p>
              <dl class="bf-facts">
                <div>
                  <dt>Amount</dt>
                  <dd>{b.amount}</dd>
                </div>
                <div>
                  <dt>Documents</dt>
                  <dd>{b.docs.length}</dd>
                </div>
              </dl>
              <ul class="bf-uses">
                {b.uses.slice(0, 3).map((u) => <li>{u}</li>)}
                {b.uses.length > 3 && <li class="bf-more">+{b.uses.length - 3} more</li>}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>

    <div class="bf-shared" data-reveal>
      <p class="label">Then the same for all four</p>
      <ol class="bf-flow">
        {shared.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .bf-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 24px 5vw;
    align-items: end;
    margin-bottom: clamp(56px, 8vw, 112px);
  }

  .bf-intro .sec-title {
    margin-bottom: 0;
  }

  .bf-lede {
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .bf-files {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    align-items: end;
  }

  .bf-file {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Index cards behind the file: each one peeks above the next, narrower the further back. */
  .bf-stack {
    display: flex;
    flex-direction: column;
  }

  .bf-sheet {
    --ink-soft: color-mix(in srgb, var(--ink) 58%, var(--paper));
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-inline: calc(var(--j) * 5px);
    padding: 10px 14px 18px;
    margin-bottom: -8px;
    border-radius: 4px 4px 0 0;
    font-size: 12px;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) calc(100% - var(--j) * 4%), var(--bg));
    box-shadow: 0 -1px 0 #0000001a inset, 0 -10px 24px #00000040;
    transition:
      margin 0.7s var(--ease),
      transform 0.7s var(--ease);
  }

  .bf-sheet span:first-child {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bf-sheet-n {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* On hover the stack fans open a little, like thumbing through the folder. */
  .bf-file:hover .bf-sheet {
    margin-bottom: -2px;
    margin-inline: calc(var(--j) * 3px);
  }

  .bf-card {
    --ink-soft: color-mix(in srgb, var(--ink) 62%, var(--paper));
    --rule: color-mix(in srgb, var(--ink) 14%, transparent);
    position: relative;
    display: grid;
    gap: 14px;
    padding: clamp(20px, 2vw, 28px);
    border-radius: 4px;
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 -12px 30px #00000040, 0 30px 70px #00000080;
    font-size: var(--t-sm);
    transition: transform 0.7s var(--ease);
  }

  .bf-file:hover .bf-card {
    transform: translateY(6px);
  }

  .bf-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }

  .bf-mono {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent);
    font: 400 15px/1 var(--font-display);
    letter-spacing: 0.04em;
  }

  .bf-meta {
    display: grid;
    gap: 2px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bf-fileno {
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }

  .bf-name {
    font: 400 clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem) / 1.12 var(--font-display);
  }

  .bf-about {
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.5;
  }

  .bf-purpose {
    font: 400 1.05rem/1.35 var(--font-display);
    padding-left: 12px;
    border-left: 1px solid var(--accent);
  }

  .bf-facts {
    display: flex;
    justify-content: space-between;
    padding-block: 12px;
    border-block: 1px solid var(--rule);
  }

  .bf-facts dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .bf-facts dd {
    margin-top: 4px;
    font: 400 1.15rem/1 var(--font-display);
    font-variant-numeric: tabular-nums;
  }

  .bf-facts div:last-child {
    text-align: right;
  }

  .bf-uses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 12px;
  }

  .bf-uses li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bf-uses li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink);
  }

  .bf-uses .bf-more {
    color: var(--ink-soft);
  }

  .bf-uses .bf-more::before {
    background: none;
    border: 1px solid currentColor;
  }

  .bf-shared {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 16px 5vw;
    align-items: center;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }

  .bf-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 400 var(--t-lg) / 1.2 var(--font-display);
  }

  .bf-flow li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bf-flow li + li::before {
    content: '';
    width: clamp(12px, 3vw, 48px);
    height: 1px;
    background: var(--accent);
  }

  @media (width <= 1100px) {
    .bf-files {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 56px;
    }
  }

  @media (width <= 900px) {
    .bf-intro,
    .bf-shared {
      grid-template-columns: 1fr;
    }

    .bf-flow {
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }

  @media (width <= 600px) {
    .bf-files {
      grid-template-columns: 1fr;
    }
  }
</style>
