---
/* Illustrative Leaf loan record. All values are sample data, not claims. */
interface Props {
  decorative?: boolean;
}

const { decorative = false } = Astro.props;

const stages = [
  { name: 'Apply', date: '3 Sep' },
  { name: 'Score', date: '9 Sep' },
  { name: 'Approve', date: '14 Sep' },
  { name: 'Disburse', date: '22 Sep' },
  { name: 'Monitor', date: 'now' },
  { name: 'Collect', date: '' },
];
const active = 4;
const a11y = decorative
  ? { 'aria-hidden': 'true' }
  : {
      role: 'img',
      'aria-label':
        'Illustrative Leaf loan record: client header, six-stage timeline with Monitor active, approvals, collateral and audit trail.',
    };
---

<div class="rec" {...a11y}>
  <div class="rec-bar">
    <span class="rec-logo"><span class="mark mark-leaf"></span> Leaf</span>
    <span class="rec-crumb">Loans / LF-2026-0418</span>
    <span class="rec-user">Credit administration</span>
  </div>

  <div class="rec-head">
    <div>
      <p class="rec-name">Example Trading Sh.p.k.</p>
      <p class="rec-sub">SME, client since 2021. Branch Prishtina 2.</p>
    </div>
    <dl class="rec-facts">
      <div><dt>Product</dt><dd>Working-capital loan</dd></div>
      <div><dt>Amount</dt><dd>EUR 120,000</dd></div>
      <div><dt>Term</dt><dd>36 months</dd></div>
      <div><dt>Status</dt><dd><span class="rec-chip">In monitoring</span></dd></div>
    </dl>
  </div>

  <ol class="rec-tl">
    {
      stages.map((s, i) => (
        <li class:list={[{ done: i < active, active: i === active }]}>
          <span class="rec-dot" />
          <span>{s.name}</span>
          <span class="rec-dim">{s.date}</span>
        </li>
      ))
    }
  </ol>

  <div class="rec-body">
    <div class="rec-panel rec-wide">
      <p class="rec-h">Approvals</p>
      <table class="rec-table">
        <thead>
          <tr><th>Approver</th><th>Limit</th><th>Decision</th><th>Time</th></tr>
        </thead>
        <tbody>
          <tr><td>Branch manager</td><td>to EUR 50,000</td><td>Recommended</td><td>12 Sep, 09:41</td></tr>
          <tr><td>Risk department</td><td>to EUR 150,000</td><td>Approved</td><td>13 Sep, 16:05</td></tr>
          <tr><td>Credit committee</td><td>above EUR 150,000</td><td>Not required</td><td></td></tr>
        </tbody>
      </table>
    </div>
    <div class="rec-panel">
      <p class="rec-h">Collateral</p>
      <ul class="rec-list">
        <li><span>Mortgage, commercial premises</span><span class="rec-dim">Next revaluation 2 Sep 2027</span></li>
        <li><span>Movable pledge, delivery vehicle</span><span class="rec-dim">Registered 20 Sep</span></li>
      </ul>
    </div>
    <div class="rec-panel">
      <p class="rec-h">Audit trail</p>
      <ul class="rec-list">
        <li><span>Disbursement released, tranche 1 of 1</span><span class="rec-dim">22 Sep, 11:20</span></li>
        <li><span>Contract generated, template SME-WC v3</span><span class="rec-dim">22 Sep, 10:02</span></li>
        <li><span>Approved within limit, risk department</span><span class="rec-dim">13 Sep, 16:05</span></li>
      </ul>
    </div>
  </div>
</div>
