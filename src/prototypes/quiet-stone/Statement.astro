<section id="statement" class="sec">
  <div class="wrap statement">
    <div class="statement-copy">
      <p class="label label-mark" data-reveal><span class="mark mark-leaf" aria-hidden="true"></span>What changes</p>
      <p class="statement-text" data-reveal style="--d:.1s">
        Leaf is the loan management system your credit, risk and compliance teams share, from the
        first application to the last repayment. Every hand-off is tracked on the same record.
      </p>
      <a class="link link-arrow" href="#lifecycle" data-reveal style="--d:.2s">How Leaf works</a>
    </div>

    <div class="statement-media" aria-hidden="true">
      <div class="pane pane-a" data-reveal="mask">
        <div class="pane-in" data-parallax="0.06">
          <p class="rec-h">Approval route</p>
          <ol class="route">
            <li class="done"><span>Branch manager</span><span class="rec-dim">to EUR 50,000</span><span>Recommended</span></li>
            <li class="done"><span>Risk department</span><span class="rec-dim">to EUR 150,000</span><span>Approved</span></li>
            <li><span>Credit committee</span><span class="rec-dim">above EUR 150,000</span><span class="rec-dim">Not required</span></li>
          </ol>
        </div>
      </div>
      <div class="pane pane-b" data-reveal="mask" style="--d:.25s">
        <div class="pane-in">
          <p class="rec-h">Audit trail</p>
          <ul class="rec-list">
            <li><span>Scorecard applied, 0 knock-outs</span><span class="rec-dim">9 Sep, 14:37</span></li>
            <li><span>Registry exposure imported</span><span class="rec-dim">9 Sep, 14:30</span></li>
            <li><span>Application opened</span><span class="rec-dim">3 Sep, 10:12</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap stats">
    <div class="stat stat-main" data-reveal>
      <p class="stat-big">25%</p>
      <p class="stat-txt">less time spent handling each loan.</p>
      <p class="stat-src">Measured at [client bank], [period], across [number] loan files.</p>
    </div>
    <div class="stat" data-reveal style="--d:.1s">
      <p class="stat-mid">[X] days</p>
      <p class="stat-src">from application to disbursement</p>
    </div>
    <div class="stat" data-reveal style="--d:.2s">
      <p class="stat-mid">[X]%</p>
      <p class="stat-src">of files decided without re-keying data</p>
    </div>
  </div>
</section>
