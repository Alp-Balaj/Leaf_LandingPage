---
// The stage name set huge and faint, sweeping in from the left one stage at a
// time, with a counter and the stage detail underneath. Fills its parent box;
// timing comes from --step and --cycle on the parent.
import { stages } from './stages';
---

<div class="words" aria-hidden="true">
  <div class="word-stack">
    {
      stages.map((s, i) => (
        <span class="word" style={`--i: ${i}`}>
          {s.name}
        </span>
      ))
    }
  </div>

  <div class="meta">
    <span class="count">
      {
        stages.map((_, i) => (
          <span class="cycle" style={`--i: ${i}`}>
            {String(i + 1).padStart(2, '0')}
          </span>
        ))
      }
      <span class="of">/ {String(stages.length).padStart(2, '0')}</span>
    </span>
    <span class="details">
      {
        stages.map((s, i) => (
          <span class="cycle" style={`--i: ${i}`}>
            {s.detail}
          </span>
        ))
      }
    </span>
  </div>
</div>

<style>
  /* Words end on the box's right edge, so the parent decides how far they run in.
     The box is a size container so the word can be sized to fit it. */
  .words {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    display: grid;
    place-content: center end;
    justify-items: end;
    text-align: right;
    color: var(--stone);
  }

  /* All five words share one grid cell; each owns one step of the loop. */
  .word-stack {
    display: grid;
    justify-items: end;
  }

  .word {
    grid-area: 1 / 1;
    /* The longest stage name ("Approve") is about 3.8em wide. */
    font: 400 min(14rem, 26cqi) / 1 var(--font-display);
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--stone) 14%, transparent);
    clip-path: inset(0 100% 0 0);
    animation: word var(--cycle) var(--ease) calc(var(--i) * var(--step)) infinite both;
  }

  .meta {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 20px;
    margin-top: 4px;
    font-size: var(--t-sm);
  }

  .count,
  .details {
    display: grid;
  }

  /* The detail is right-aligned in a column as wide as the longest detail, so the
     counter goes after it to stay beside the text. */
  .count {
    order: 2;
    grid-template-columns: auto auto;
    justify-content: start;
    gap: 8px;
    font: 500 var(--t-xs) / 1.4 var(--font-body);
    letter-spacing: 0.18em;
  }

  .count .cycle,
  .details .cycle {
    grid-area: 1 / 1;
  }

  .details .cycle {
    color: color-mix(in srgb, var(--stone) 60%, transparent);
  }

  .of {
    opacity: 0.4;
  }

  .cycle {
    opacity: 0;
    animation: swap var(--cycle) var(--ease) calc(var(--i) * var(--step)) infinite both;
  }

  @keyframes word {
    0% {
      clip-path: inset(0 100% 0 0);
      transform: translateX(-6%);
    }
    7.2%,
    16.8% {
      clip-path: inset(0);
      transform: none;
      opacity: 1;
    }
    21.6%,
    100% {
      clip-path: inset(0);
      opacity: 0;
    }
  }

  @keyframes swap {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    4.8%,
    16.8% {
      opacity: 1;
      transform: none;
    }
    20.4%,
    100% {
      opacity: 0;
    }
  }

  /* On a phone the word starts on the gutter, in line with the headline, and the
     counter stacks over the detail. */
  @media (width <= 720px) {
    .words,
    .word-stack {
      place-content: center start;
      justify-items: start;
      text-align: left;
    }

    .word {
      font-size: clamp(3.5rem, 18vw, 5rem);
    }

    .meta {
      grid-template-columns: auto;
      gap: 6px;
      margin-top: 8px;
    }

    .count {
      order: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .cycle {
      animation: none;
    }

    .word:first-child,
    .cycle:first-child {
      clip-path: none;
      opacity: 1;
    }
  }
</style>
