---
/* The lifecycle: one stage per page in a swipe track, the next page peeking at the edge.
   A I–VI strip on top doubles as progress and jump links (with the stage names on desktop);
   previous and next sit underneath, with the next team named between them. Never advances
   on its own. Panel values are sample data. */
import { stages, roman } from './lifecycle-stages';
---

<div class="deck" data-deck data-next-up={JSON.stringify(stages.map((s) => [s.name, s.who]))}>
  <nav class="deck-steps" aria-label="Stages" data-reveal>
    <ol>
      {
        stages.map((s, i) => (
          <li>
            <button
              type="button"
              class="deck-step"
              data-step={i}
              aria-controls={`qs-deck-${i}`}
              aria-current={i === 0 ? 'step' : undefined}
              aria-label={`${s.name}, stage ${i + 1} of ${stages.length}`}
            >
              <span class="deck-step-n">{roman[i]}</span>
              <span class="deck-step-name" aria-hidden="true">{s.name}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </nav>

  <ol
    class="deck-track"
    data-track
    tabindex="0"
    aria-label="Stages. Swipe, or use the arrow keys."
    data-reveal
    style="--d:.1s"
  >
    {
      stages.map((s, i) => (
        <li class:list={['deck-page', { 'is-current': i === 0 }]} id={`qs-deck-${i}`} data-page={i}>
          <div class="deck-copy">
            <p class="deck-n">
              {roman[i]}
              <span>of VI</span>
            </p>
            <h3 class="deck-name">{s.name}</h3>
            <p class="deck-body">{s.body}</p>
          </div>
          <div class="deck-sheet">
            <dl class="rec-kv">
              {s.panel.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
            <p class="deck-who">
              <span class="label">Worked by</span>
              {s.who}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="deck-ctrl" data-reveal style="--d:.2s">
    <button type="button" class="deck-btn deck-prev" data-prev aria-label="Previous stage" disabled>
      <span aria-hidden="true"></span>
    </button>
    <p class="deck-status" aria-live="polite" data-status>
      Next: <b>{stages[1].name}</b>, {stages[1].who}
    </p>
    <button type="button" class="deck-btn deck-next" data-next aria-label="Next stage">
      <span aria-hidden="true"></span>
    </button>
  </div>
</div>

<style>
  .deck-steps ol {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
  }

  .deck-step {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 10px 12px;
    padding: 10px 0 0;
    background: none;
    border: 0;
    color: var(--ink-soft);
    font: 400 var(--t-sm) / 1 var(--font-display);
    text-align: left;
    cursor: pointer;
    transition: color 0.5s var(--ease);
  }

  /* The bar under each numeral mirrors the record's mini timeline. */
  .deck-step::after {
    content: '';
    grid-column: 1 / -1;
    height: 2px;
    background: var(--rule);
    transition: background-color 0.5s var(--ease);
  }

  .deck-step.is-done::after {
    background: var(--stone);
  }

  .deck-step-name {
    display: none;
  }

  .deck-step[aria-current='step'] {
    color: var(--accent);
  }

  .deck-step[aria-current='step']::after {
    background: var(--accent);
  }

  /* The track runs out to the right screen edge so the next page peeks in; on the left it
     stops at the content edge, which clips pages already passed. The offset repeats .wrap's
     maths rather than using %, which scroll-padding would resolve against the track. */
  .deck-track {
    --bleed: calc(max(0px, (100vw - var(--max)) / 2) + var(--gutter));
    --peek: 36px;
    --gap: 12px;
    list-style: none;
    margin: 0 calc(-1 * var(--bleed)) 0 0;
    padding: 0 var(--bleed) 0 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  /* Room after the last page, so it too can snap to the content edge. */
  .deck-track::after {
    content: '';
    flex: 0 0 calc(var(--peek) - var(--gap));
  }

  .deck-track::-webkit-scrollbar {
    display: none;
  }

  .deck-track:focus-visible {
    outline-offset: -2px;
  }

  /* Pages are a little narrower than the screen so the next one peeks in. */
  .deck-page {
    flex: 0 0 calc(100% - var(--peek));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    opacity: 0.4;
    transition: opacity 0.6s var(--ease);
  }

  .deck-page.is-current {
    opacity: 1;
  }

  .deck-n {
    font: 400 var(--t-sm) / 1 var(--font-display);
    color: var(--accent);
  }

  .deck-n span {
    margin-left: 6px;
    color: var(--ink-soft);
  }

  .deck-name {
    margin: 10px 0 14px;
    font: 400 var(--t-2xl) / 1 var(--font-display);
  }

  .deck-body {
    font-size: var(--t-sm);
    color: var(--ink-soft);
    margin-bottom: 24px;
  }

  .deck-sheet {
    margin-top: auto;
    padding: 6px 18px 18px;
    background: var(--paper);
    color: var(--ink);
    --ink-soft: color-mix(in srgb, var(--ink) 62%, var(--paper));
    --rule: color-mix(in srgb, var(--ink) 14%, transparent);
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
    border-radius: 3px;
  }

  .deck-sheet .rec-kv > div {
    padding: 9px 0;
  }

  /* Tablets: the page is wide enough to set the copy beside its record sheet. */
  @media (width >= 600px) {
    .deck-page {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }

    .deck-copy,
    .deck-sheet {
      flex: 1;
      min-width: 0;
    }

    .deck-body {
      margin-bottom: 0;
    }
  }

  .deck-who {
    margin-top: 14px;
    display: grid;
    gap: 4px;
  }

  /* Desktop: stage names in the strip, a wider page with a large name beside the sheet. */
  @media (width > 900px) {
    .deck-steps ol {
      gap: 12px;
      margin-bottom: clamp(40px, 5vw, 72px);
    }

    .deck-step {
      padding-top: 0;
    }

    .deck-step-name {
      display: block;
      font-size: var(--t-lg);
      color: var(--ink-soft);
      transition: color 0.5s var(--ease);
    }

    .deck-step:hover .deck-step-name,
    .deck-step[aria-current='step'] .deck-step-name {
      color: var(--stone);
    }

    .deck-track {
      --peek: 160px;
      --gap: 48px;
    }

    .deck-page {
      gap: 6vw;
    }

    .deck-copy {
      flex: 1;
    }

    .deck-name {
      margin: 16px 0 24px;
      font-size: clamp(3.5rem, 2rem + 3.5vw, 6rem);
    }

    .deck-body {
      max-width: 34ch;
      font-size: 1.0625rem;
    }

    .deck-sheet {
      flex: 0 0 min(44%, 520px);
      padding: 14px 32px 28px;
      font-size: 0.9375rem;
    }

    .deck-sheet .rec-kv > div {
      padding: 12px 0;
    }

    .deck-ctrl {
      margin-top: clamp(32px, 4vw, 56px);
    }

    .deck-status {
      font-size: var(--t-sm);
    }

    .deck-btn {
      width: 56px;
      height: 56px;
    }

    .deck-btn:not(:disabled):hover {
      border-color: var(--stone);
    }
  }

  .deck-ctrl {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }

  .deck-status {
    flex: 1;
    min-width: 0;
    text-align: center;
    font-size: var(--t-xs);
    color: var(--ink-soft);
  }

  .deck-status b {
    font-weight: 500;
    color: var(--stone);
  }

  .deck-btn {
    flex: none;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: var(--stone);
    cursor: pointer;
    transition:
      border-color 0.4s var(--ease),
      opacity 0.4s var(--ease);
  }

  .deck-btn:not(:disabled):active {
    border-color: var(--accent);
  }

  .deck-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Hairline arrows, matching the link-arrow on the page. */
  .deck-btn span {
    position: relative;
    width: 18px;
    height: 1px;
    background: currentColor;
  }

  .deck-btn span::after {
    content: '';
    position: absolute;
    top: -3.5px;
    width: 8px;
    height: 8px;
    border: solid currentColor;
    border-width: 1px 1px 0 0;
  }

  .deck-next span::after {
    right: 0;
    transform: rotate(45deg);
  }

  .deck-prev span::after {
    left: 0;
    transform: rotate(-135deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
    const track = deck.querySelector<HTMLElement>('[data-track]')!;
    const pages = [...deck.querySelectorAll<HTMLElement>('[data-page]')];
    const steps = [...deck.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const prev = deck.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = deck.querySelector<HTMLElement>('[data-status]')!;
    const nextUp: [string, string][] = JSON.parse(deck.dataset.nextUp!);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    const set = (i: number) => {
      if (i === current) return;
      current = i;
      steps.forEach((s, j) => {
        s.classList.toggle('is-done', j < i);
        if (j === i) s.setAttribute('aria-current', 'step');
        else s.removeAttribute('aria-current');
      });
      pages.forEach((p, j) => p.classList.toggle('is-current', j === i));
      prev.disabled = i === 0;
      next.disabled = i === pages.length - 1;
      const up = nextUp[i + 1];
      status.innerHTML = up
        ? `Next: <b>${up[0]}</b>, ${up[1]}`
        : 'Last stage. A restructure stays on this record.';
    };

    const go = (i: number) => {
      const page = pages[Math.max(0, Math.min(i, pages.length - 1))];
      track.scrollTo({
        left: page.offsetLeft - pages[0].offsetLeft,
        behavior: reduce ? 'auto' : 'smooth',
      });
    };

    // The page whose left edge sits nearest the snap line is the current one.
    let queued = false;
    track.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          const x = track.scrollLeft;
          let best = 0;
          pages.forEach((p, j) => {
            const d = Math.abs(p.offsetLeft - pages[0].offsetLeft - x);
            const bd = Math.abs(pages[best].offsetLeft - pages[0].offsetLeft - x);
            if (d < bd) best = j;
          });
          set(best);
        });
      },
      { passive: true }
    );

    steps.forEach((s, i) => s.addEventListener('click', () => go(i)));
    prev.addEventListener('click', () => go(current - 1));
    // Arrow keys step through the stages from the strip and the buttons; the track
    // scrolls with them natively.
    deck.addEventListener('keydown', (e) => {
      if (e.target === track || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
      e.preventDefault();
      const i = current + (e.key === 'ArrowRight' ? 1 : -1);
      go(i);
      steps[Math.max(0, Math.min(i, steps.length - 1))].focus({ preventScroll: true });
    });
    next.addEventListener('click', () => go(current + 1));
  });
</script>
