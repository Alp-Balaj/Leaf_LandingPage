---
import RecordMock from './RecordMock.astro';
---

<header class="hero" data-hero>
  <div class="hero-frame">
    <div class="hero-img">
      <RecordMock decorative />
    </div>
  </div>
  <div class="hero-shade"></div>

  <div class="hero-content wrap">
    <h1 class="hero-title">From application to collection, on one record.</h1>
    <div class="hero-foot">
      <p class="hero-caption">
        <span class="label">On the record</span>
        <span>LF-2026-0418, working-capital loan. Illustrative data.</span>
      </p>
      <p class="hero-lede">
        The loan management system your credit, risk and compliance teams share.
        <a class="link" href="#demo">Book a live demo</a>
      </p>
      <a class="scroll label" href="#statement">Scroll</a>
    </div>
  </div>
</header>
