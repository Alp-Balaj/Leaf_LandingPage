---
const controls = [
  {
    title: 'Permissions by role and module',
    body: 'Each user sees and does only what their role allows.',
  },
  {
    title: 'Approval limits per branch and product',
    body: 'Applications route to the right authority by your rules.',
  },
  {
    title: 'Full audit trail',
    body: 'Who changed what, and when, on every application.',
  },
  {
    title: 'Credit registry and core banking',
    body: 'Exposure imported from the registry; accounts and payments read from your core system.',
  },
  {
    title: 'Fully configurable scoring',
    body: 'Scorecards, rating limits, qualitative and statistical conditions, stages, knock-out and adjustment rules, all edited in Administration.',
  },
  {
    title: 'Reassignment by administrators',
    body: 'Hand files, roles and rights to other officers in Administration, without IT.',
  },
  {
    title: 'Automatic notifications',
    body: 'Officers and clients are told the moment a file moves, a review falls due or a term changes.',
  },
  {
    title: 'Reports and executive summary',
    body: 'Portfolio and monitoring reports generated on demand, with an executive summary on every file.',
  },
  {
    title: 'Certified management systems',
    body: 'iA is certified to ISO 27001 (information security), ISO 20000-1 (IT service management), ISO 9001 (quality), ISO 14001 (environment) and ISO 45001 (health and safety).',
  },
];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX'];

// Sign-off: words rise in, the year rolls in on odometer strips, then the timeline draws.
const since = 2015;
const words = ['Banking', 'software', 'since'];
// Each strip spins once through 0–9 before settling on its digit.
const digits = [...String(since)].map(Number);
const ticks = new Date().getFullYear() - since;
---

<section id="controls" class="sec">
  <div class="wrap">
    <div class="runhead" data-reveal>
      <h2 class="label">Controls</h2>
    </div>
    <p class="sec-title" data-reveal style="--d:.1s">Built to pass your risk and compliance review.</p>
    <dl class="ctl-grid">
      {
        controls.map((c, i) => (
          <div class="ctl" data-reveal style={`--d:${((i % 3) * 0.1).toFixed(1)}s`}>
            <span class="ctl-n" aria-hidden="true">{roman[i]}</span>
            <dt>{c.title}</dt>
            <dd>{c.body}</dd>
          </div>
        ))
      }
    </dl>

    <div class="since" data-reveal>
      <p class="sec-title since-title" aria-label={`${words.join(' ')} ${since}.`}>
        {
          words.map((w, i) => (
            <span class="since-w" aria-hidden="true">
              <span style={`--i:${i}`}>{w}</span>
            </span>
          ))
        }
        <span class="since-year" aria-hidden="true">
          {
            digits.map((d, i) => (
              <span class="odo" style={`--i:${i};--d:${d}`}>
                <span class="odo-size">{d}</span>
                <span class="odo-strip">
                  {[...Array(10 + d + 1).keys()].map((n) => (
                    <span>{n % 10}</span>
                  ))}
                </span>
              </span>
            ))
          }
          <span class="since-dot">.</span>
        </span>
      </p>

      <div class="since-line" aria-hidden="true">
        <span class="since-end">{since}</span>
        <span class="since-track">
          {[...Array(ticks + 1).keys()].map((i) => <i style={`--t:${i / ticks}`} />)}
          <b class="since-now" />
        </span>
        <span class="since-end">Today</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Feed the pointer position to the card's spotlight.
  for (const card of document.querySelectorAll<HTMLElement>('#controls .ctl')) {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  }
</script>
