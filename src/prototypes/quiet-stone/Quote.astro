---
import RecordMock from './RecordMock.astro';
---

<section class="quote" aria-label="Principle">
  <div class="quote-bg" aria-hidden="true">
    <div class="quote-img" data-parallax="0.12">
      <RecordMock decorative />
    </div>
  </div>
  <div class="quote-shade" aria-hidden="true"></div>
  <blockquote class="quote-text wrap" data-reveal>
    <p>The record is the control. No file waits in someone’s inbox.</p>
  </blockquote>
</section>
