---
/* The closing sheet: the one light surface on the dark page. It sits with the footer in
   .closing (index.astro), held on screen while it grows from a small box, its content playing
   in once it has opened (motion.ts), until the footer slides up over it. The address is set edge to edge and is the section's only call to
   action. The prefilled body asks for what the old form did. */
const email = 'info@interadria-ks.com';
const mailto =
  `mailto:${email}?subject=${encodeURIComponent('Leaf live demo')}` +
  `&body=${encodeURIComponent('Bank:\r\nYour role:\r\n')}`;

const titleWords = 'See your own loan process in Leaf.'.split(' ');

// Phones break the address after the @, so it is set as two runs of letters.
const at = email.indexOf('@') + 1;
const runs = [email.slice(0, at), email.slice(at)];
---

<span id="demo" class="demo-anchor"></span>
<section class="demo-sheet" aria-label="Contact" data-sheet>
    <div class="wrap demo">
      <div class="demo-head">
        <div class="demo-pitch">
          <p class="label label-mark"><span class="mark mark-leaf" aria-hidden="true"></span>Live demo</p>
          <h2 class="demo-title">
            {
              titleWords.map((w, i) => (
                <>
                  <span class="demo-w"><span style={`--i:${i}`}>{w}</span></span>{' '}
                </>
              ))
            }
          </h2>
        </div>
        <p class="demo-lede">
          Write to us and we will set up 45 minutes with the team that builds it. Bring your credit
          and risk leads.
        </p>
      </div>

      <div class="demo-contact">
        <div class="demo-fit">
          <a class="demo-mail" href={mailto} aria-label={`Email ${email}`}>
            {
              runs.map((run, r) => (
                <span class="demo-run">
                  {[...run].map((c, i) => (
                    <span class="demo-ch" data-c={c} style={`--i:${i + (r ? at : 0)}`}>
                      <span>{c}</span>
                    </span>
                  ))}
                </span>
              ))
            }
          </a>
        </div>
        <div class="demo-rule" aria-hidden="true"></div>

        <div class="demo-actions">
          <a class="demo-btn demo-send" href={mailto}>Email us</a>
          <button class="demo-btn demo-copy" type="button" data-copy={email}>
            <span class="demo-copy-roll">
              <span>Copy address</span>
              <span aria-hidden="true" data-copy-done>Copied</span>
            </span>
          </button>
          <p class="demo-note">We reply within one working day.</p>
          <span class="demo-status" role="status" data-copy-status></span>
        </div>
      </div>
    </div>
</section>
<div class="demo-hold" aria-hidden="true"></div>

<script>
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]')!;
  const done = copy.querySelector<HTMLElement>('[data-copy-done]')!;
  const status = document.querySelector<HTMLElement>('[data-copy-status]')!;
  const mail = document.querySelector<HTMLElement>('.demo-mail')!;
  let timer = 0;

  copy.addEventListener('click', async () => {
    let message = 'Copied';
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
    } catch {
      // No clipboard access (an http page or a denied permission): leave the address ready to copy.
      getSelection()?.selectAllChildren(mail);
      message = 'Selected';
    }
    done.textContent = message;
    status.textContent = message === 'Copied' ? 'Address copied' : 'Address selected';
    copy.classList.add('is-done');
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      copy.classList.remove('is-done');
      status.textContent = '';
    }, 2200);
  });
</script>
