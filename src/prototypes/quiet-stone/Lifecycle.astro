---
import LifecycleDeck from './LifecycleDeck.astro';

// The stage deck at every width. A "mobile" slot swaps in another layout below 900px
// (the prototypes in lifecycle-mobile/ use it).
const hasMobile = Astro.slots.has('mobile');
---

<section id="lifecycle" class="sec band lifecycle">
  <div class="wrap">
    <div class="runhead" data-reveal>
      <h2 class="label">How Leaf works</h2>
      <span class="label">Six stages, one record</span>
    </div>

    <div class:list={['stages-deck', { 'has-mobile': hasMobile }]}>
      <LifecycleDeck />
    </div>
    {hasMobile && <div class="stages-mobile"><slot name="mobile" /></div>}
  </div>
</section>
