---
const stages = [
  {
    name: 'Apply',
    body: 'Individuals, micro, SME and corporate clients in one place. Client data, products, co-borrowers and guarantors are captured once and reused at every later step.',
    who: 'Branch officer',
  },
  {
    name: 'Score',
    body: 'Financial statements, credit-registry exposure and your internal scorecard come together in the file, with knock-out and adjustment criteria applied automatically.',
    who: 'Credit analyst, Risk',
  },
  {
    name: 'Approve',
    body: 'The application routes from branch to risk to committee by the approval limits you set per branch and product.',
    who: 'Branch manager, Risk, Committee',
  },
  {
    name: 'Disburse',
    body: 'Contracts are generated from your own templates. Collateral and mortgages sit on the same record, and disbursement is controlled product by product.',
    who: 'Credit administration',
  },
  {
    name: 'Monitor',
    body: 'Reviews and early warnings are raised automatically for collateral revaluation, product expiry and special conditions.',
    who: 'Monitoring team',
  },
  {
    name: 'Collect',
    body: 'Arrears are sorted by days of delay and handed to collectors or executors. Restructure terms without opening a new file.',
    who: 'Collections',
  },
];
---

<section id="lifecycle" class="section">
  <div class="wrap ledger" data-reveal>
    <div class="side">
      <h2 class="section-title">How Leaf works, step by step.</h2>
      <p class="section-intro">
        Every hand-off is tracked on the same record, and no file waits in someone's inbox.
      </p>

      <div class="proof">
        <p class="figure">25%</p>
        <p class="claim">less time spent handling each loan.</p>
        <p class="source">Measured at [client bank], [period], across [number] loan files.</p>
      </div>

      <a class="btn btn-quiet cta" href="#demo">Book a 45-minute demo</a>
    </div>

    <ol class="stages">
      {
        stages.map((s, i) => (
          <li class="stage">
            <span class="num">{i + 1}</span>
            <div class="text">
              <h3>{s.name}</h3>
              <p class="body">{s.body}</p>
            </div>
            <p class="who">{s.who}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proof {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    max-width: 360px;
  }

  .figure {
    font-size: 56px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .claim {
    margin-top: 8px;
    font-size: 18px;
  }

  .source {
    margin-top: 6px;
    font-size: 13.5px;
    color: var(--ink-faint);
  }

  .cta {
    margin-top: 28px;
  }

  .stages {
    border-top: 1px solid var(--rule);
  }

  .stage {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 150px;
    gap: 8px 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .num {
    font-size: 14px;
    color: var(--red);
    padding-top: 4px;
  }

  h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .body {
    margin-top: 6px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 52ch;
  }

  .who {
    font-size: 13.5px;
    color: var(--ink-faint);
    text-align: right;
    padding-top: 4px;
  }

  @media (max-width: 720px) {
    .stage {
      grid-template-columns: 32px minmax(0, 1fr);
    }
    .who {
      grid-column: 2;
      text-align: left;
      padding-top: 0;
    }
  }
</style>
