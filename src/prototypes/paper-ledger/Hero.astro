---
import RecordMock from './RecordMock.astro';
---

<header id="top" class="hero">
  <div class="wrap">
    <p class="category" data-hero>Loan management system for banks</p>
    <h1 data-hero>From application to collection, on one record.</h1>
    <p class="lede" data-hero>
      Leaf is the loan management system your credit, risk and compliance teams share, from the
      first application to the last repayment.
    </p>
    <div class="actions" data-hero>
      <a class="btn" href="#demo">Book a 45-minute demo</a>
      <a class="btn btn-quiet" href="#lifecycle">See how it works</a>
    </div>
  </div>

  <div class="wrap mock-wrap" id="record" data-hero>
    <RecordMock />
    <p class="caption">
      <span>The loan record, one screen. Illustrative data; your products, limits and templates
        replace it.</span>
      <span>Choose a stage to see what the record shows at that point.</span>
    </p>
  </div>
</header>

<style>
  .hero > .wrap:first-child {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: 40px;
  }

  .category {
    font-size: 15px;
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .category::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }

  h1 {
    margin-top: 18px;
    max-width: 16ch;
    font-size: clamp(36px, 5vw, 62px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 22px;
    max-width: 52ch;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mock-wrap {
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .caption {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    font-size: 13.5px;
    color: var(--ink-faint);
  }

  @media (max-width: 720px) {
    .caption span:last-child {
      display: none;
    }
  }
</style>
