---
const roles = [
  'Retail or SME lending',
  'Credit risk',
  'Operations',
  'IT',
  'Compliance',
  'Management board',
];
---

<section id="demo" class="section">
  <div class="wrap ledger" data-reveal>
    <div class="copy">
      <h2 class="section-title">See your own loan process in Leaf.</h2>
      <p class="section-intro">45 minutes with the team that builds it. Bring your credit and risk leads.</p>

      <dl class="what">
        <div class="leader"><span>Length</span><span>45 minutes</span></div>
        <div class="leader"><span>Where</span><span>Online, on a live Leaf instance</span></div>
        <div class="leader"><span>You meet</span><span>[Product lead]</span></div>
        <div class="leader"><span>We reply within</span><span>One working day</span></div>
      </dl>

      <p class="contact">
        Or call <a href="tel:+38338229170">+383 38 229 170</a><br />
        <a href="https://interadria-ks.com">interadria-ks.com</a>
      </p>
    </div>

    <div class="form-col">
      <div class="thanks" hidden>
        <p class="thanks-title" tabindex="-1">Thank you.</p>
        <p class="thanks-body">We will contact you within one working day to set a time.</p>
      </div>

      <!-- TODO: point action at the real endpoint that receives demo requests. -->
      <form class="demo-form" method="post" action="#">
        <div class="field">
          <label for="f-name">Full name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-bank">Bank</label>
          <input id="f-bank" name="bank" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="f-role">Your role</label>
          <select id="f-role" name="role">
            {roles.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-email">Work email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <button type="submit" class="btn submit">Book a 45-minute demo</button>
        <p class="privacy">We use these details only to arrange the demo. [Link to privacy notice]</p>
      </form>
    </div>
  </div>
</section>

<script>
  import { animate } from 'motion/mini';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const form = document.querySelector<HTMLFormElement>('#demo .demo-form')!;
  const thanks = document.querySelector<HTMLElement>('#demo .thanks')!;

  const showThanks = () => {
    form.hidden = true;
    thanks.hidden = false;
    thanks.querySelector<HTMLElement>('.thanks-title')!.focus();
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (reduce) {
      showThanks();
      return;
    }
    animate(form, { opacity: [1, 0], transform: ['translateY(0px)', 'translateY(-6px)'] }, { duration: 0.18 })
      .finished.then(() => {
        showThanks();
        animate(
          thanks,
          { opacity: [0, 1], transform: ['translateY(8px)', 'translateY(0px)'] },
          { duration: 0.35, ease: [0.2, 0.7, 0.2, 1] },
        );
      });
  });
</script>

<style>
  .what {
    margin-top: 28px;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
  }

  .what .leader > span:first-child {
    color: var(--ink-faint);
  }

  .contact {
    margin-top: 28px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-muted);
  }

  .form-col {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: 0 1px 2px rgba(21, 21, 19, 0.04);
  }

  .thanks[hidden] {
    display: none;
  }

  .thanks-title {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    outline: none;
  }

  .thanks-body {
    margin-top: 10px;
    font-size: 16px;
    color: var(--ink-muted);
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .demo-form[hidden] {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
  }

  input,
  select {
    min-height: 46px;
    padding: 0 12px;
    background: var(--paper);
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }

  input:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 0;
    border-color: var(--ink);
  }

  .submit {
    margin-top: 6px;
    width: 100%;
  }

  .privacy {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-faint);
  }

  @media (max-width: 480px) {
    .form-col {
      padding: 20px;
    }
  }
</style>
