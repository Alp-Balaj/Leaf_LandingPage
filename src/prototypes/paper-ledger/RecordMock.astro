---
// Illustrative sample record. Everything here is sample data for the mock,
// not a claim about a customer.
type Row = { k: string; v: string; tone?: 'ok' | 'warn' | 'red' };
type Stage = {
  name: string;
  role: string;
  status: string;
  statusTone: 'neutral' | 'ok' | 'warn';
  heading: string;
  rows: Row[];
  note?: string;
};

const stages: Stage[] = [
  {
    name: 'Apply',
    role: 'Branch officer',
    status: 'In application',
    statusTone: 'neutral',
    heading: 'Application LN-2026-0418',
    rows: [
      { k: 'Product', v: 'SME working capital, 36 months' },
      { k: 'Amount requested', v: 'EUR 120,000.00' },
      { k: 'Purpose', v: 'Stock and receivables' },
      { k: 'Co-borrowers and guarantors', v: '1 guarantor, linked' },
      { k: 'Client data', v: 'Captured once, reused at every later step' },
    ],
    note: 'Individuals, micro, SME and corporate clients use the same record.',
  },
  {
    name: 'Score',
    role: 'Credit analyst, Risk',
    status: 'Scored, awaiting approval',
    statusTone: 'neutral',
    heading: 'Internal scorecard, run 11 Mar 2026',
    rows: [
      { k: 'Financial statements', v: '3 periods, declared against assumed' },
      { k: 'Credit-registry exposure', v: 'EUR 48,200.00 across 2 institutions' },
      { k: 'Knock-out criteria', v: '4 of 4 passed', tone: 'ok' },
      { k: 'Adjustment criteria', v: '+1 grade, management quality' },
      { k: 'Internal rating', v: 'B+, 62 of 100' },
    ],
    note: 'Knock-out and adjustment criteria are applied automatically from your own model.',
  },
  {
    name: 'Approve',
    role: 'Branch manager, Risk, Committee',
    status: 'Approved within limit',
    statusTone: 'ok',
    heading: 'Approval chain, by limit per branch and product',
    rows: [
      { k: 'Branch manager, A.K.  (limit EUR 50,000)', v: 'Approved  12 Mar 2026  09:41', tone: 'ok' },
      { k: 'Risk department, E.R.  (limit EUR 250,000)', v: 'Approved  12 Mar 2026  14:08', tone: 'ok' },
      { k: 'Credit committee  (above EUR 250,000)', v: 'Not required for this amount' },
      { k: 'Conditions attached', v: 'Insurance policy before tranche 2' },
    ],
    note: 'Every approval is stored with approver, limit and timestamp.',
  },
  {
    name: 'Disburse',
    role: 'Credit administration',
    status: 'Tranche 1 released',
    statusTone: 'ok',
    heading: 'Contract and disbursement',
    rows: [
      { k: 'Contract', v: 'Generated from template SME-WC v4, 13 Mar 2026' },
      { k: 'Tranche 1 of 2', v: 'EUR 80,000.00 released 14 Mar 2026', tone: 'ok' },
      { k: 'Tranche 2 of 2', v: 'EUR 40,000.00 held, condition open', tone: 'warn' },
      { k: 'Collateral registered', v: 'Mortgage and vehicle pledge, with history' },
    ],
    note: 'Disbursement is controlled product by product.',
  },
  {
    name: 'Monitor',
    role: 'Monitoring team',
    status: 'Under review, 2 warnings',
    statusTone: 'warn',
    heading: 'Reviews and early warnings',
    rows: [
      { k: 'Collateral revaluation', v: 'Due 14 Mar 2027' },
      { k: 'Insurance policy', v: 'Expires 30 Sep 2026', tone: 'warn' },
      { k: 'Special condition, quarterly P&L', v: 'Q2 received, Q3 outstanding', tone: 'warn' },
      { k: 'Product expiry', v: '14 Mar 2029' },
    ],
    note: 'Warnings are raised automatically; nothing waits in an inbox.',
  },
  {
    name: 'Collect',
    role: 'Collections',
    status: '31 to 60 days past due',
    statusTone: 'warn',
    heading: 'Arrears and collection',
    rows: [
      { k: 'Days of delay', v: '34' },
      { k: 'Overdue', v: 'EUR 3,610.00, 1 instalment', tone: 'warn' },
      { k: 'Assigned to', v: 'Collector M.B., call logged 2 Jun 2026' },
      { k: 'Restructure', v: 'Available on this record, no new file' },
    ],
    note: 'Arrears are sorted by days of delay and handed to collectors or executors.',
  },
];

const audit = [
  { t: '12 Mar 14:08', who: 'E.R., Risk', what: 'Approved within limit' },
  { t: '12 Mar 09:41', who: 'A.K., Branch 02', what: 'Approved, forwarded to Risk' },
  { t: '11 Mar 16:20', who: 'System', what: 'Scorecard v3.2 run, B+' },
  { t: '11 Mar 10:05', who: 'D.S., Branch 02', what: 'Registry exposure imported' },
  { t: '10 Mar 11:05', who: 'D.S., Branch 02', what: 'Application created' },
];
---

<div class="mock" data-stage="3" aria-label="Leaf loan record, sample">
  <div class="chrome">
    <span class="crumbs">
      <span>Loans</span><span class="sep">/</span><span>LN-2026-0418</span><span class="sep">/</span
      ><span class="client">Drini Trading Sh.p.k.</span>
    </span>
    <span class="sample">Sample record</span>
  </div>

  <div class="head">
    <div class="who">
      <p class="name">Drini Trading Sh.p.k.</p>
      <p class="meta">Micro and SME, Branch 02 Prishtina, officer D.S.</p>
    </div>
    <div class="amount">
      <span>Approved amount</span>
      <strong>EUR 120,000.00</strong>
    </div>
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      <span class="status-text">{stages[2].status}</span>
    </p>
  </div>

  <ol class="timeline" aria-hidden="true">
    {stages.map((s) => <li><span class="pip"></span><span class="lbl">{s.name}</span></li>)}
  </ol>

  <div class="body">
    <div class="stages">
      <ol class="tabs">
        {
          stages.map((s, i) => {
            const open = i === 2;
            return (
              <li>
                <button
                  type="button"
                  class="tab"
                  data-index={i}
                  data-status={s.status}
                  data-tone={s.statusTone}
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={`rec-panel-${i}`}
                >
                  <span class="n">{i + 1}</span>
                  <span class="t">{s.name}</span>
                  <span class="chev" aria-hidden="true"></span>
                </button>
                <div id={`rec-panel-${i}`} class="panel" hidden={!open}>
                  <div class="panel-head">
                    <p class="panel-title">{s.heading}</p>
                    <p class="panel-role">{s.role}</p>
                  </div>
                  <dl class="rows">
                    {s.rows.map((r) => (
                      <div class={`row${r.tone ? ` tone-${r.tone}` : ''}`}>
                        <dt>{r.k}</dt>
                        <dd>{r.v}</dd>
                      </div>
                    ))}
                  </dl>
                  {s.note && <p class="panel-note">{s.note}</p>}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>

    <aside class="side">
      <section class="block">
        <h3>Collateral</h3>
        <dl class="mini">
          <div class="leader"><span>Mortgage, commercial premises</span><span>EUR 180,000</span></div>
          <div class="leader"><span>Vehicle pledge</span><span>EUR 22,000</span></div>
          <div class="leader total"><span>Coverage</span><span>168%</span></div>
        </dl>
      </section>
      <section class="block">
        <h3>Audit trail</h3>
        <ol class="audit">
          {
            audit.map((a) => (
              <li>
                <span class="at">{a.t}</span>
                <span class="by">{a.who}</span>
                <span class="did">{a.what}</span>
              </li>
            ))
          }
        </ol>
      </section>
    </aside>
  </div>
</div>

<script>
  import { animate } from 'motion/mini';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mock = document.querySelector<HTMLElement>('.mock')!;
  const tabs = Array.from(mock.querySelectorAll<HTMLButtonElement>('.tab'));
  const steps = Array.from(mock.querySelectorAll<HTMLElement>('.timeline li'));
  const statusText = mock.querySelector<HTMLElement>('.status-text')!;
  const status = mock.querySelector<HTMLElement>('.status')!;
  const narrow = matchMedia('(max-width: 719px)');

  function setStage(index: number, fromUser = false) {
    const target = tabs[index];
    const wasOpen = target.getAttribute('aria-expanded') === 'true';
    // Desktop tabs always keep one open; the mobile accordion may close.
    const closeAll = fromUser && wasOpen && narrow.matches;

    tabs.forEach((tab, i) => {
      const open = !closeAll && i === index;
      const panel = document.getElementById(tab.getAttribute('aria-controls')!)!;
      const wasPanelOpen = !panel.hidden;
      tab.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open && !wasPanelOpen && !reduce) {
        animate(
          panel,
          { opacity: [0, 1], transform: ['translateY(6px)', 'translateY(0px)'] },
          { duration: 0.22, ease: [0.2, 0.7, 0.2, 1] },
        );
      }
    });

    if (closeAll) return;
    mock.dataset.stage = String(index + 1);
    steps.forEach((li, i) => {
      li.classList.toggle('done', i < index);
      li.classList.toggle('current', i === index);
    });
    statusText.textContent = target.dataset.status ?? '';
    status.dataset.tone = target.dataset.tone ?? 'neutral';
    if (!reduce) {
      animate(status, { opacity: [0.4, 1] }, { duration: 0.3 });
    }
  }

  tabs.forEach((tab) => tab.addEventListener('click', () => setStage(Number(tab.dataset.index), true)));

  // Arrow keys move between stages on desktop, like a tab strip.
  mock.querySelector('.tabs')!.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    const current = tabs.findIndex((t) => t === document.activeElement);
    if (current < 0 || narrow.matches) return;
    const delta = ke.key === 'ArrowRight' ? 1 : ke.key === 'ArrowLeft' ? -1 : 0;
    if (!delta) return;
    ke.preventDefault();
    const next = (current + delta + tabs.length) % tabs.length;
    tabs[next].focus();
    setStage(next);
  });

  // Initial state, without animation.
  const start = tabs.findIndex((t) => t.getAttribute('aria-expanded') === 'true');
  steps.forEach((li, i) => {
    li.classList.toggle('done', i < start);
    li.classList.toggle('current', i === start);
  });
  status.dataset.tone = tabs[start].dataset.tone ?? 'neutral';
</script>

<style>
  .mock {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow:
      0 1px 2px rgba(21, 21, 19, 0.04),
      0 24px 48px -32px rgba(21, 21, 19, 0.25);
    font-size: 13.5px;
    line-height: 1.45;
    overflow: hidden;
  }

  .chrome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink-faint);
    font-size: 12.5px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .crumbs .client {
    color: var(--ink);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sample {
    flex: 0 0 auto;
    padding: 2px 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 11.5px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 36px;
    padding: 18px 20px 14px;
  }

  .who {
    flex: 1 1 240px;
    min-width: 0;
  }

  .name {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .meta {
    margin-top: 3px;
    color: var(--ink-muted);
  }

  .amount {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--ink-muted);
    font-size: 12.5px;
  }

  .amount strong {
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 11px 5px 9px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--paper);
    font-weight: 500;
    white-space: nowrap;
  }

  .status .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-faint);
  }

  .status[data-tone='ok'] {
    background: var(--ok-soft);
    border-color: transparent;
    color: var(--ok);
  }

  .status[data-tone='ok'] .dot {
    background: var(--ok);
  }

  .status[data-tone='warn'] {
    background: var(--red-soft);
    border-color: transparent;
    color: var(--red);
  }

  .status[data-tone='warn'] .dot {
    background: var(--red);
  }

  /* Timeline across the six stages */

  .timeline {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    padding: 6px 20px 16px;
    border-bottom: 1px solid var(--rule);
  }

  .timeline li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
    font-size: 12px;
    color: var(--ink-faint);
  }

  .timeline li::before {
    content: '';
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--rule);
  }

  .timeline li.done::before {
    background: var(--ink);
  }

  .timeline li.current::before {
    background: linear-gradient(90deg, var(--ink) 0 50%, var(--rule) 50% 100%);
  }

  .timeline .pip {
    position: relative;
    z-index: 1;
    width: 10px;
    height: 10px;
    margin-left: calc(50% - 5px);
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--rule-strong);
  }

  .timeline li.done .pip {
    background: var(--ink);
    border-color: var(--ink);
  }

  .timeline li.current .pip {
    background: var(--red);
    border-color: var(--red);
    box-shadow: 0 0 0 3px var(--red-soft);
  }

  .timeline .lbl {
    text-align: center;
  }

  .timeline li.done .lbl,
  .timeline li.current .lbl {
    color: var(--ink);
  }

  .timeline li.current .lbl {
    font-weight: 500;
  }

  /* Body: tabs + side */

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 272px;
  }

  .stages {
    min-width: 0;
    border-right: 1px solid var(--rule);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto;
  }

  .tabs > li {
    display: contents;
  }

  .tab {
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 46px;
    padding: 0 6px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink-muted);
    font-size: 13px;
    cursor: pointer;
    position: relative;
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab .n {
    font-size: 11px;
    color: var(--ink-faint);
  }

  .tab .chev {
    display: none;
  }

  .tab[aria-expanded='true'] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 500;
    border-bottom-color: transparent;
  }

  .tab[aria-expanded='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--red);
  }

  .tab[aria-expanded='true'] .n {
    color: var(--red);
  }

  .tab:focus-visible {
    outline-offset: -3px;
  }

  .panel {
    grid-row: 2;
    grid-column: 1 / -1;
    padding: 18px 20px 20px;
    min-height: 268px;
  }

  .panel[hidden] {
    display: none;
  }

  .panel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin-bottom: 10px;
  }

  .panel-title {
    font-weight: 600;
    font-size: 14px;
  }

  .panel-role {
    color: var(--ink-faint);
    font-size: 12.5px;
  }

  .rows .row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid var(--rule);
  }

  .rows dt {
    color: var(--ink-muted);
  }

  .rows dd {
    color: var(--ink);
    text-align: right;
  }

  .row.tone-ok dd {
    color: var(--ok);
  }

  .row.tone-warn dd {
    color: var(--red);
  }

  .panel-note {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: 12.5px;
  }

  .side {
    padding: 16px 20px 20px;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .block h3 {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 8px;
  }

  .mini {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 12.5px;
  }

  .mini .leader span:first-child {
    color: var(--ink-muted);
    white-space: normal;
  }

  .mini .total span {
    font-weight: 600;
    color: var(--ink);
  }

  .audit {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 12px;
  }

  .audit li {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 1px 10px;
  }

  .audit .at {
    color: var(--ink-faint);
    grid-row: 1 / 3;
  }

  .audit .by {
    color: var(--ink-muted);
  }

  .audit .did {
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .body {
      grid-template-columns: 1fr;
    }
    .stages {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .side {
      flex-direction: row;
      gap: 28px;
    }
    .side .block {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  @media (max-width: 719px) {
    /* Accordion: each stage button is followed by its own panel. */
    .tabs {
      display: block;
    }
    .tabs > li {
      display: block;
      border-bottom: 1px solid var(--rule);
    }
    .tab {
      width: 100%;
      justify-content: flex-start;
      gap: 12px;
      min-height: 50px;
      padding: 0 18px;
      border-bottom: 0;
      background: var(--surface);
      text-align: left;
    }
    .tab[aria-expanded='true']::after {
      top: 0;
      bottom: 0;
      right: auto;
      width: 3px;
      height: auto;
    }
    .tab .t {
      flex: 1 1 auto;
    }
    .tab .chev {
      display: block;
      width: 8px;
      height: 8px;
      border-right: 1.5px solid var(--ink-faint);
      border-bottom: 1.5px solid var(--ink-faint);
      transform: rotate(45deg) translateY(-2px);
      transition: transform 150ms ease;
    }
    .tab[aria-expanded='true'] .chev {
      transform: rotate(-135deg) translateY(-2px);
    }
    .panel {
      min-height: 0;
      padding: 4px 18px 18px;
    }
    .rows .row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .rows dd {
      text-align: left;
    }
    .side {
      flex-direction: column;
    }
    .head {
      padding: 16px 18px 12px;
    }
    .timeline {
      padding: 4px 18px 14px;
    }
    .timeline .lbl {
      font-size: 10.5px;
    }
  }
</style>
