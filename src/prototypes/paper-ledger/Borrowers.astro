---
const borrowers = [
  {
    title: 'Individuals',
    body: 'Income and expense analysis, co-borrowers and guarantors, payroll-linked loans created automatically.',
  },
  {
    title: 'Micro and SME',
    body: 'Balance sheet and P&L over three periods, declared against assumed figures, and credit limits that open new applications.',
  },
  {
    title: 'Corporate',
    body: 'Full financial-statement analysis, legal opinion, mortgages and movable collateral kept with their history.',
  },
];
---

<section id="borrowers" class="section">
  <div class="wrap" data-reveal>
    <div class="head">
      <h2 class="section-title">Individuals, micro, SME and corporate in one place.</h2>
      <p class="section-intro">
        The same record, with the analysis each borrower type needs.
      </p>
    </div>

    <ul class="cards">
      {
        borrowers.map((b) => (
          <li class="card">
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { animate } from 'motion/mini';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover)').matches;

  if (!reduce && fine) {
    document.querySelectorAll<HTMLElement>('#borrowers .card').forEach((card) => {
      const lift = (y: number) =>
        animate(
          card,
          { transform: `translateY(${y}px)` },
          { duration: 0.45, ease: [0.22, 1.2, 0.36, 1] },
        );
      card.addEventListener('pointerenter', () => lift(-4));
      card.addEventListener('pointerleave', () => lift(0));
    });
  }
</script>

<style>
  .head {
    max-width: 640px;
  }

  .cards {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    padding: 22px 22px 26px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: 0 1px 2px rgba(21, 21, 19, 0.04);
    transition: box-shadow 300ms ease;
  }

  .card:hover {
    box-shadow:
      0 1px 2px rgba(21, 21, 19, 0.04),
      0 18px 32px -24px rgba(21, 21, 19, 0.3);
  }

  h3 {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }

  .card p {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
