---
import RecordMock from './RecordMock.astro';
---

<header class="wrap hero">
  <div class="copy">
    <h1>From application to collection, on one record.</h1>
    <p class="lede">
      Leaf is the loan management system your credit, risk and compliance teams share, from the
      first application to the last repayment.
    </p>
    <div class="actions">
      <a class="btn" href="#demo">Book a 45-minute demo</a>
      <a class="btn btn-quiet" href="#lifecycle">See the product</a>
    </div>
    <p class="note">On a live Leaf instance, with the team that builds it. Bring your credit and risk leads.</p>
  </div>
  <RecordMock />
</header>

<style>
  .hero {
    padding-top: clamp(24px, 4vw, 56px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
    }
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 18px;
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .note {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink-3);
    max-width: 44ch;
  }
</style>
