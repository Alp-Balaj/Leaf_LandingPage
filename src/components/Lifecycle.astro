---
const stages = [
  {
    name: 'Apply',
    body: 'Individuals, micro, SME and corporate clients in one place. Client data, products, co-borrowers and guarantors are captured once and reused at every later step.',
    who: 'BRANCH OFFICER',
  },
  {
    name: 'Score',
    body: 'Financial statements, credit-registry exposure and your internal scorecard come together in the file, with knock-out and adjustment criteria applied automatically.',
    who: 'CREDIT ANALYST · RISK',
  },
  {
    name: 'Approve',
    body: 'The application routes from branch to risk to committee by the approval limits you set per branch and product.',
    who: 'BRANCH MANAGER · RISK · COMMITTEE',
  },
  {
    name: 'Disburse',
    body: 'Contracts are generated from your own templates. Collateral and mortgages sit on the same record, and disbursement is controlled product by product.',
    who: 'CREDIT ADMINISTRATION',
  },
  {
    name: 'Monitor',
    body: 'Reviews and early warnings are raised automatically for collateral revaluation, product expiry and special conditions.',
    who: 'MONITORING TEAM',
  },
  {
    name: 'Collect',
    body: 'Arrears are sorted by days of delay and handed to collectors or executors. Restructure terms without opening a new file.',
    who: 'COLLECTIONS',
  },
];
---

<section id="lifecycle" class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow">ONE SYSTEM, THE WHOLE LOAN</p>
      <h2 class="section-title">How Leaf works, step by step.</h2>
      <p class="intro">
        Tap a step. Every hand-off is tracked on the same record, and no file waits in someone's
        inbox.
      </p>
    </div>

    <ol class="stages">
      {
        stages.map((s, i) => {
          const open = i === 0;
          return (
            <li>
              <button
                type="button"
                class="stage"
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={`stage-${i}`}
              >
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{s.name}</span>
                <span class="sign" aria-hidden="true" />
              </button>
              <div id={`stage-${i}`} class="detail" hidden={!open}>
                <p class="body">{s.body}</p>
                <p class="who">{s.who}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#lifecycle .stage');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const wasOpen = button.getAttribute('aria-expanded') === 'true';
      buttons.forEach((b) => {
        const open = b === button && !wasOpen;
        b.setAttribute('aria-expanded', String(open));
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
      });
    });
  });
</script>

<style>
  .split > .stages {
    flex-basis: 420px;
  }

  .intro {
    margin-top: 16px;
    max-width: 420px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .stages {
    margin: 0;
    padding: 0 0 0 22px;
    list-style: none;
    display: flex;
    flex-direction: column;
    border-left: 2px solid var(--accent);
  }

  li {
    border-bottom: 1px solid var(--rule-soft);
  }

  .stage {
    width: 100%;
    min-height: 56px;
    padding: 14px 0;
    background: transparent;
    border: 0;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 18px;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .num {
    width: 22px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--ink-muted);
  }

  .name {
    flex: 1 1 auto;
    font-size: 20px;
    font-weight: 300;
  }

  .sign {
    font-size: 20px;
    font-weight: 300;
    color: var(--ink-muted);
  }

  .sign::before {
    content: '+';
  }

  .stage[aria-expanded='true'] .num {
    color: var(--accent);
  }

  .stage[aria-expanded='true'] .name {
    font-weight: 400;
  }

  .stage[aria-expanded='true'] .sign::before {
    content: '−';
  }

  .detail {
    padding: 0 0 20px 40px;
  }

  .body {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .who {
    margin-top: 10px;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }
</style>
