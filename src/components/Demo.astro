---
const roles = [
  'Retail or SME lending',
  'Credit risk',
  'Operations',
  'IT',
  'Compliance',
  'Management board',
];
---

<section id="demo" class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow">LIVE DEMO</p>
      <h2 class="title">See your own loan process in Leaf.</h2>
      <div class="accent-rule" aria-hidden="true"></div>
      <p class="pitch">45 minutes with the team that builds it. Bring your credit and risk leads.</p>
      <p class="contact">
        Or call <a href="tel:+38338229170">+383 38 229 170</a><br />
        <a href="https://interadria-ks.com">interadria-ks.com</a>
      </p>
    </div>

    <div class="form-col">
      <div class="thanks" hidden>
        <p class="thanks-title" tabindex="-1">Thank you.</p>
        <p class="thanks-body">We will contact you within one working day to set a time.</p>
      </div>

      <!-- TODO: point action at the real endpoint that receives demo requests. -->
      <form class="demo-form" method="post" action="#">
        <div class="field">
          <label for="f-name">FULL NAME</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-bank">BANK</label>
          <input id="f-bank" name="bank" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="f-role">YOUR ROLE</label>
          <select id="f-role" name="role">
            {roles.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-email">WORK EMAIL</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <button type="submit" class="btn submit">Request a demo</button>
        <p class="privacy">We use these details only to arrange the demo. [Link to privacy notice]</p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#demo .demo-form')!;
  const thanks = document.querySelector<HTMLElement>('#demo .thanks')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    thanks.hidden = false;
    thanks.querySelector<HTMLElement>('.thanks-title')!.focus();
  });
</script>

<style>
  .split > .form-col {
    flex-basis: 340px;
  }

  .title {
    margin-top: 18px;
    font-size: clamp(30px, 4.6vw, 44px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .accent-rule {
    margin-top: 24px;
  }

  .pitch {
    margin-top: 20px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .contact {
    margin-top: 24px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-muted);
  }

  .contact a[href^='tel'] {
    font-weight: 400;
  }

  .thanks {
    padding-top: 8px;
  }

  .thanks-title {
    font-size: 28px;
    outline: none;
  }

  .thanks-body {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .demo-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .demo-form[hidden] {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
  }

  input,
  select {
    min-height: 48px;
    padding: 0 2px;
    background: var(--ground);
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    border-radius: 0;
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 18px;
  }

  select {
    padding: 0;
  }

  input:focus-visible,
  select:focus-visible {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .submit {
    align-self: flex-start;
    min-height: 50px;
    margin-top: 8px;
    padding: 0 30px;
  }

  .privacy {
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-faint);
  }
</style>
