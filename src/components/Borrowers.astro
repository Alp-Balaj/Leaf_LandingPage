---
const borrowers = [
  {
    title: 'Individuals',
    body: 'Income and expense analysis, co-borrowers and guarantors, payroll-linked loans created automatically.',
  },
  {
    title: 'Micro and SME',
    body: 'Balance sheet and P&L over three periods, declared against assumed figures, and credit limits that open new applications.',
  },
  {
    title: 'Corporate',
    body: 'Full financial-statement analysis, legal opinion, mortgages and movable collateral kept with their history.',
  },
];
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow">EVERY BORROWER</p>
    <h2 class="section-title">Individuals, micro, SME and corporate in one place.</h2>
    <div class="grid">
      {
        borrowers.map((b) => (
          <div class="grid-item">
            <p class="title">{b.title}</p>
            <p>{b.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid-item {
    padding: 22px 0;
  }

  .title {
    font-size: 20px;
    font-weight: 400;
  }

  .grid-item p:last-child {
    margin-top: 8px;
    line-height: 1.55;
  }
</style>
